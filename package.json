{
	"name": "blog",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"add-track": "bun run scripts/add-track.ts",
		"suno": "cd tools/suno-cli && bun run src/index.ts",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"lint": "biome check --fix && oxlint --fix --ignore-pattern '*.astro'",
		"lint:check": "biome check && oxlint --ignore-pattern '*.astro'",
		"format": "biome format --write",
		"check": "astro check",
		"seo:check": "bun run scripts/seo-check.ts",
		"links:check": "linkinator ./dist --recurse --skip '^(?!http://localhost)' --skip 'https?://(?!jval\\.dev)' --verbosity error",
		"prebuild": "bun run seo:check",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/rss": "^4.0.14",
		"@astrojs/sitemap": "^3.6.0",
		"@types/bun": "^1.3.5",
		"@types/node": "^25.0.6",
		"astro": "^5.16.6",
		"commander": "^15.0.0",
		"exponential-backoff": "^3.1.3",
		"ora": "^9.0.0",
		"cli-progress": "^3.12.0",
		"@types/cli-progress": "^3.11.5",
		"playwright": "^1.57.0",
		"sharp": "^0.34.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/language-server": "^2.16.2",
		"@astrojs/partytown": "^2.1.4",
		"@biomejs/biome": "^2.3.11",
		"@cloudflare/workers-types": "^5.20260726.1",
		"@vitest/ui": "^4.0.17",
		"front-matter": "^4.0.2",
		"happy-dom": "^20.3.1",
		"lefthook": "^2.0.13",
		"linkinator": "^7.5.3",
		"oxlint": "^1.38.0",
		"schema-dts": "^2.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.17"
	}
}
