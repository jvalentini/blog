---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

const DEFAULT_OG_IMAGE = '/waves-hero.png';

interface PlayerCardProps {
	embedUrl: string;
	streamUrl: string;
	slug: string;
	width?: number;
	height?: number;
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	playerCard?: PlayerCardProps;  // Optional: enables Twitter Player Card for audio
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = DEFAULT_OG_IMAGE, playerCard } = Astro.props;

// Handle both ImageMetadata and string URLs
const imageUrl = typeof image === 'string' ? image : new URL(image.src, Astro.url);

// Determine Twitter card type
const twitterCardType = playerCard ? 'player' : 'summary_large_image';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Turnstile preconnect for better performance -->
<link rel="preconnect" href="https://challenges.cloudflare.com" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<!-- Twitter -->
<meta name="twitter:card" content={twitterCardType} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{/* Twitter Player Card additional tags for audio/video embeds */}
{playerCard && (
	<>
		<meta name="twitter:player" content={playerCard.embedUrl} />
		<meta name="twitter:player:width" content={String(playerCard.width ?? 480)} />
		<meta name="twitter:player:height" content={String(playerCard.height ?? 200)} />
		<meta name="twitter:player:stream" content={playerCard.streamUrl} />
		<meta name="twitter:player:stream:content_type" content="audio/mpeg" />
		<link rel="alternate" type="application/json+oembed" 
			href={`${Astro.site?.origin ?? ''}/oembed/${playerCard.slug}.json`} 
			title={title} />
	</>
)}
