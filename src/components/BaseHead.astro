---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import wavesHeroImage from '../assets/waves-hero.png';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, SOCIAL_LINKS } from '../consts';

// Default OG image as ImageMetadata for optimization
const DEFAULT_OG_IMAGE: ImageMetadata = wavesHeroImage;

interface PlayerCardProps {
	embedUrl: string;
	streamUrl: string;
	slug: string;
	width?: number;
	height?: number;
}

interface ArticleData {
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
}

interface HowToStep {
	name: string;
	text: string;
}

interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	playerCard?: PlayerCardProps;
	article?: ArticleData;
	howTo?: { steps: HowToStep[]; totalTime?: string };
	faq?: FAQItem[];
	breadcrumbs?: { label: string; url: string }[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = DEFAULT_OG_IMAGE, playerCard, article, howTo, faq, breadcrumbs } = Astro.props;

// Handle both ImageMetadata and string URLs
// For ImageMetadata, get the optimized image URL and construct full URL using site origin
// For strings (external URLs), use as-is
const imageUrl =
	typeof image === 'string'
		? image
		: new URL((await getImage({ src: image, width: 1200, height: 630 })).src, Astro.site ?? Astro.url).href;

// Determine Twitter card type
const twitterCardType = playerCard ? 'player' : 'summary_large_image';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Turnstile preconnect for better performance -->
<link rel="preconnect" href="https://challenges.cloudflare.com" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<!-- Twitter -->
<meta name="twitter:card" content={twitterCardType} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{/* Twitter Player Card additional tags for audio/video embeds */}
{playerCard && (
	<>
		<meta name="twitter:player" content={playerCard.embedUrl} />
		<meta name="twitter:player:width" content={String(playerCard.width ?? 480)} />
		<meta name="twitter:player:height" content={String(playerCard.height ?? 200)} />
		<meta name="twitter:player:stream" content={playerCard.streamUrl} />
		<meta name="twitter:player:stream:content_type" content="audio/mpeg" />
		<link rel="alternate" type="application/json+oembed" 
			href={`${Astro.site?.origin ?? ''}/oembed/${playerCard.slug}.json`} 
			title={title} />
	</>
)}

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"description": SITE_DESCRIPTION,
	"url": Astro.site?.href,
})} />

<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	"name": AUTHOR_NAME,
	"url": Astro.site?.href,
	"sameAs": [
		SOCIAL_LINKS.linkedin,
		SOCIAL_LINKS.github,
	],
	"email": SOCIAL_LINKS.email,
})} />

{article && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": title,
		"description": description,
		"image": imageUrl,
		"datePublished": article.pubDate?.toISOString(),
		"dateModified": article.updatedDate?.toISOString() ?? article.pubDate?.toISOString(),
		"author": {
			"@type": "Person",
			"name": AUTHOR_NAME,
			"url": Astro.site?.href,
			"sameAs": [
				SOCIAL_LINKS.linkedin,
				SOCIAL_LINKS.github,
			],
		},
		"publisher": {
			"@type": "Person",
			"name": AUTHOR_NAME,
		},
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalURL.href,
		},
		"keywords": article.tags?.join(', '),
	})} />
)}

{howTo && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "HowTo",
		"name": title,
		"description": description,
		"totalTime": howTo.totalTime,
		"step": howTo.steps.map((step, index) => ({
			"@type": "HowToStep",
			"position": index + 1,
			"name": step.name,
			"text": step.text,
		})),
	})} />
)}

{faq && faq.length > 0 && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": faq.map((item) => ({
			"@type": "Question",
			"name": item.question,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": item.answer,
			},
		})),
	})} />
)}

{breadcrumbs && breadcrumbs.length > 0 && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": breadcrumbs.map((crumb, index) => ({
			"@type": "ListItem",
			"position": index + 1,
			"name": crumb.label,
			"item": crumb.url,
		})),
	})} />
)}
