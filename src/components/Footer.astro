---
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer>
	<div class="footer-content">
		<div class="terminal-line">
			<span class="prompt">$</span>
			<span class="command">echo $COPYRIGHT</span>
		</div>
		<p class="copyright">
			&copy; {currentYear} {AUTHOR_NAME}
		</p>
		
		<div class="footer-links">
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">
				<span class="link-prefix">[git]</span> github
			</a>
			<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener">
				<span class="link-prefix">[in]</span> linkedin
			</a>
			<a href={`mailto:${SOCIAL_LINKS.email}`}>
				<span class="link-prefix">[@]</span> email
			</a>
			<a href="/rss.xml">
				<span class="link-prefix">[rss]</span> feed
			</a>
		</div>
		
		<div class="session-info">
			<span class="muted">session started:</span>
			<span class="date" id="session-date"></span>
		</div>
	</div>
</footer>

<script>
	const dateEl = document.getElementById('session-date');
	if (dateEl) {
		dateEl.textContent = new Date().toISOString().split('T')[0];
	}
</script>

<style>
	footer {
		margin-top: auto;
		padding: var(--space-2xl) var(--space-md);
		border-top: 1px solid var(--border-dim);
		background-color: var(--bg-deep);
	}

	.footer-content {
		max-width: var(--content-wide);
		margin: 0 auto;
		text-align: center;
	}

	.terminal-line {
		display: inline-flex;
		gap: var(--space-sm);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-xs);
	}

	.prompt {
		color: var(--phosphor-base);
	}

	.command {
		color: var(--text-secondary);
	}

	.copyright {
		color: var(--text-muted);
		font-size: var(--font-size-sm);
		margin: 0 0 var(--space-lg) 0;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--space-md);
		margin-bottom: var(--space-lg);
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--text-secondary);
		font-size: var(--font-size-sm);
		text-decoration: none;
		padding: var(--space-xs) var(--space-sm);
		border-radius: 4px;
		transition: all var(--transition-fast);
	}

	.footer-links a:hover {
		color: var(--phosphor-base);
		background-color: var(--bg-surface);
	}

	.link-prefix {
		color: var(--phosphor-dim);
		font-size: var(--font-size-xs);
	}

	.footer-links a:hover .link-prefix {
		color: var(--phosphor-base);
	}

	.session-info {
		font-size: var(--font-size-xs);
		color: var(--text-muted);
	}

	.muted {
		opacity: 0.5;
	}

	.date {
		color: var(--amber-base);
		opacity: 0.7;
	}

	@media (max-width: 720px) {
		.footer-links {
			gap: var(--space-sm);
		}

		.footer-links a {
			font-size: var(--font-size-xs);
		}
	}
</style>
