      return;
    }
    
    switch(e.key) {
      case ' ': // Space - play/pause
        e.preventDefault();
        if (currentIndex < 0) {
          loadTrack(0, true);
        } else if (audio.paused) {
          audio.play();
        } else {
          audio.pause();
        }
        break;
        
      case 'ArrowUp': // Volume up
        e.preventDefault();
        const newVolumeUp = Math.min(10, Math.round(audio.volume * 10) + 1);
        setVolume(newVolumeUp);
        break;
        
      case 'ArrowDown': // Volume down
        e.preventDefault();
        const newVolumeDown = Math.max(0, Math.round(audio.volume * 10) - 1);
        setVolume(newVolumeDown);
        break;
        
      case 'ArrowLeft': // Restart or previous
        e.preventDefault();
        playPrevious(); // Already handles < 3s logic
        break;
        
      case 'ArrowRight': // Next song
        e.preventDefault();
        playNext();
        break;
        
      case 'm': // Mute toggle
      case 'M':
        e.preventDefault();
        if (audio.volume > 0) {
          previousVolume = audio.volume;
          setVolume(0);
        } else {
          const restoreLevel = Math.round(previousVolume * 10) || 7;
          setVolume(restoreLevel);
        }
        break;
        
       case 'g': // Toggle genre
       case 'G':
         e.preventDefault();
         const newGenre = currentGenre === 'hip-hop' ? 'country' : 'hip-hop';
         switchGenre(newGenre);
