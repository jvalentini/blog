---
import { Image } from 'astro:assets';
import { promises as fs } from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';
import wavesHeroImage from '../assets/waves-hero.png';
import genreColorsData from '../data/genre-colors.json';
import tracksData from '../data/tracks.json';
import type { ParsedLyrics } from '../scripts/music-player/types';
import { parseLyrics } from '../utils/lyrics-parser';
import HotkeysModal from './player/HotkeysModal.astro';
import LyricsPanel from './player/LyricsPanel.astro';
import PlayerControls from './player/PlayerControls.astro';
import ProgressBar from './player/ProgressBar.astro';
import QueueList from './player/QueueList.astro';
import VolumeControl from './player/VolumeControl.astro';

interface Song {
	id: string;
	title: string;
	lyrics: Record<string, string>;
	versions: Record<string, string>;
}

interface TracksConfig {
	songs: Song[];
	genres: string[];
	defaultGenre: string;
}

const config = tracksData as TracksConfig;
const { songs, genres, defaultGenre } = config;

// Build track list with version URLs
const tracks = songs.map((song, idx) => ({
	id: idx,
	songId: song.id,
	title: song.title,
	lyrics: song.lyrics,
	versions: Object.fromEntries(
		Object.entries(song.versions).map(([genre, filepath]) => [genre, `/assets/music/${filepath}`]),
	),
}));

// Load lyrics with LRC timestamp support
const lyricsDirPath = fileURLToPath(new URL('../content/lyrics', import.meta.url));
const lyricsData: Record<string, Record<string, ParsedLyrics>> = {};

try {
	let lyricsDir = lyricsDirPath;
	try {
		await fs.access(lyricsDir);
	} catch {
		lyricsDir = path.resolve(process.cwd(), 'src/content/lyrics');
	}

	for (const song of songs) {
		if (!song.lyrics) continue;
		lyricsData[song.title] = {};

		for (const [genre, filepath] of Object.entries(song.lyrics)) {
			try {
				// Try genre-specific path first (e.g., "hip-hop/slop-slinger-hip-hop.md")
				const filePath = path.join(lyricsDir, filepath);
				let markdownContent: string;

				try {
					markdownContent = await fs.readFile(filePath, 'utf-8');
				} catch {
					// Fallback to parent folder, removing genre suffix from filename
					// e.g., "without-me-pop.md" -> "without-me.md" (removing "-pop")
					const basename = path.basename(filepath);
					const genreSuffix = `-${genre}`;
					const fallbackBasename = basename.endsWith(genreSuffix + path.extname(basename))
						? basename.replace(genreSuffix + path.extname(basename), path.extname(basename))
						: basename;
					const fallbackPath = path.join(lyricsDir, fallbackBasename);
					markdownContent = await fs.readFile(fallbackPath, 'utf-8');
				}

				lyricsData[song.title]![genre] = parseLyrics(markdownContent);
			} catch (err) {
				console.warn(`Failed to load lyrics for ${song.title} (${genre}):`, err);
			}
		}
	}
} catch (err) {
	console.error('Failed to read lyrics directory:', err);
}

// Prepare data for client-side JS
const clientTracks = tracks.map((t) => ({
	id: t.id,
	songId: t.songId,
	title: t.title,
	versions: t.versions,
}));
---

<div class="music-player">
  <!-- Hero Banner with Two-Column Layout -->
  <div class="hero-now-playing">
    <Image src={wavesHeroImage} alt="" class="hero-bg" aria-hidden="true" />
    <div class="hero-content">
      <audio id="audio-player" preload="metadata"></audio>
      
      <!-- Left Column: Title, Now Playing, Controls -->
      <div class="hero-left">
        <h1 class="hero-title">waves</h1>
        
        <div class="now-playing-info">
          <div class="now-playing-label">Now Playing</div>
          <div class="track-title" id="current-track-title">Select a track</div>
          <div class="track-duration-display">
            <span id="current-time">0:00</span> / <span id="duration-time">0:00</span>
          </div>
        </div>

        <div class="player-controls">
          <PlayerControls />
          <ProgressBar />
          <VolumeControl initialVolume={7} />
        </div>
      </div>

      <!-- Right Column: Lyrics -->
      <div class="hero-right">
        <LyricsPanel />
      </div>
    </div>
  </div>

  <QueueList tracks={clientTracks} genres={genres} defaultGenre={defaultGenre} />
</div>

<HotkeysModal />

<script define:vars={{ lyricsData, clientTracks, defaultGenre, genres, genreColors: genreColorsData }}>
  // Store data globally for the music player module to access
  window.__MUSIC_PLAYER_CONFIG__ = {
    tracks: clientTracks,
    lyricsData: lyricsData,
    defaultGenre: defaultGenre,
    genres: genres,
    genreColors: genreColors
  };
</script>

<script>
  import { initMusicPlayer } from '../scripts/music-player';

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const config = (window as any).__MUSIC_PLAYER_CONFIG__;
    if (config) {
      initMusicPlayer({
        tracks: config.tracks,
        lyricsData: config.lyricsData,
        defaultGenre: config.defaultGenre,
        genres: config.genres,
        genreColors: config.genreColors
      });
    }
  });
</script>

<style>
  .music-player {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }

  /* Hero Now Playing Section */
  .hero-now-playing {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    min-height: 320px;
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.4),
      0 0 60px var(--genre-base, var(--phosphor-glow));
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.35) contrast(1.1);
    transform: scale(1.15);
    object-position: center center;
  }

  /* Two-column hero content layout */
  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr;
    align-items: stretch;
    gap: 2.5rem;
    padding: 2rem;
    height: 420px;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: center;
    min-height: 0;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--genre-base, var(--phosphor-base));
    margin: 0;
    text-shadow: var(--glow-lg);
    letter-spacing: -1px;
  }

  .now-playing-info {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 20%, transparent);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .now-playing-label {
    font-size: 0.65rem;
    color: var(--amber-base);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.35rem;
  }

  .track-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--genre-bright, var(--phosphor-bright));
    margin-bottom: 0.25rem;
    text-shadow: 0 0 10px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
  }

  .track-duration-display {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 70%, transparent);
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border-left: 1px solid color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 15%, transparent);
    padding-left: 2rem;
  }

  .player-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Responsive - Tablet: stack columns */
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      min-height: auto;
      height: auto;
    }

    .hero-right {
      border-left: none;
      border-top: 1px solid color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 15%, transparent);
      padding-left: 0;
      padding-top: 1.5rem;
      height: 280px;
      max-height: 280px;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .hero-content {
      padding: 1rem;
      gap: 1rem;
    }

    .hero-now-playing {
      min-height: auto;
    }

    .hero-left {
      gap: 0.75rem;
    }

    .hero-title {
      font-size: 1.25rem;
    }

    .now-playing-info {
      padding: 0.625rem 0.875rem;
    }

    .now-playing-label {
      display: none;
    }

    .track-title {
      font-size: 0.9rem;
      margin-bottom: 0;
    }

    .track-duration-display {
      display: none;
    }

    .player-controls {
      gap: 0.75rem;
    }
  }
</style>
