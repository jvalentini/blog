    border-radius: 3px;
  }

  .lyrics-container::-webkit-scrollbar-thumb:hover {
    background: rgba(51, 255, 51, 0.35);
  }



  .now-playing-label {
    font-size: 0.65rem;
    color: var(--amber-base);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.35rem;
