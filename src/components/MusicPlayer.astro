  }

  .control-btn.active {
    background: rgba(51, 255, 51, 0.2);
    border-color: rgba(51, 255, 51, 0.5);
    color: var(--phosphor-bright, #66ff66);
    box-shadow: 0 0 12px rgba(51, 255, 51, 0.3);
  }

  .control-btn svg {
    display: block;
  }

  #btn-shuffle,
  #btn-repeat {
    padding: 0.6rem;
  }

  .repeat-icon {
    display: none;
  }

  .repeat-icon.repeat-off {
    display: block;
  }

  #btn-repeat.active .repeat-off { display: none; }
  #btn-repeat.active .repeat-all { display: block; }
  #btn-repeat.active .repeat-one { display: none; }

  .play-btn {
    width: 56px;
    height: 56px;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn .play-icon,
  .play-btn .pause-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .progress-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .time-display {
    font-size: 0.75rem;
    color: var(--phosphor-base);
    min-width: 35px;
    text-align: center;
  }

  .progress-slider {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: rgba(51, 255, 51, 0.15);
    appearance: none;
    cursor: pointer;
  }

  .progress-slider::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--phosphor-base);
    cursor: pointer;
  }

  .volume-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .volume-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .volume-blocks {
    display: flex;
    gap: 3px;
  }

  .volume-block {
    width: 8px;
    height: 18px;
    background: var(--border-dim);
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .volume-block:hover {
    background: var(--border-base);
  }

  .volume-block[data-level="1"].active,
  .volume-block[data-level="2"].active,
  .volume-block[data-level="3"].active {
    background: #33ff33;
    box-shadow: 0 0 4px rgba(51, 255, 51, 0.4);
  }

  .volume-block[data-level="4"].active,
  .volume-block[data-level="5"].active,
  .volume-block[data-level="6"].active {
    background: #ffb84d;
    box-shadow: 0 0 4px rgba(255, 184, 77, 0.4);
  }

  .volume-block[data-level="7"].active,
  .volume-block[data-level="8"].active {
    background: #ff9500;
    box-shadow: 0 0 4px rgba(255, 149, 0, 0.4);
  }

  .volume-block[data-level="9"].active,
  .volume-block[data-level="10"].active {
    background: #ff3333;
    box-shadow: 0 0 4px rgba(255, 51, 51, 0.4);
  }

  .volume-percent {
    font-size: 0.75rem;
    color: var(--phosphor-base);
    min-width: 35px;
  }

  /* Queue Section */
  .queue-section {
    background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(20, 25, 30, 0.7) 100%);
    border: 1px solid rgba(51, 255, 51, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .queue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--phosphor-dim);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .queue-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--phosphor-base);
    margin: 0;
    transition: color 0.3s ease, text-shadow 0.3s ease;
    text-shadow: 0 0 8px rgba(51, 255, 51, 0.3);
  }

  .queue-title.country-theme {
    color: #e8b84a;
    text-shadow: 0 0 8px rgba(212, 160, 58, 0.4);
  }

  .queue-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .genre-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Genre Icon Container */
  .genre-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .genre-icon svg {
    width: 28px;
    height: 28px;
    transition: all 0.3s ease;
  }

  /* Hip-hop microphone - green terminal glow */
  .genre-icon-mic {
    color: var(--phosphor-base, #33ff33);
    filter: drop-shadow(0 0 4px rgba(51, 255, 51, 0.6))
            drop-shadow(0 0 8px rgba(51, 255, 51, 0.3));
    animation: mic-pulse 2s ease-in-out infinite;
  }

  @keyframes mic-pulse {
    0%, 100% { 
      filter: drop-shadow(0 0 4px rgba(51, 255, 51, 0.6))
              drop-shadow(0 0 8px rgba(51, 255, 51, 0.3));
    }
    50% { 
      filter: drop-shadow(0 0 6px rgba(51, 255, 51, 0.8))
              drop-shadow(0 0 12px rgba(51, 255, 51, 0.5));
    }
  }

  /* Country cowboy hat - amber Oregon Trail style */
  .genre-icon-lasso {
    color: #d4a03a;
    filter: drop-shadow(0 0 3px rgba(212, 160, 58, 0.5))
            drop-shadow(0 0 6px rgba(212, 160, 58, 0.25));
    animation: hat-tip 4s ease-in-out infinite;
  }

  @keyframes hat-tip {
    0%, 100% { 
      transform: rotate(0deg) translateY(0);
      filter: drop-shadow(0 0 3px rgba(212, 160, 58, 0.5))
              drop-shadow(0 0 6px rgba(212, 160, 58, 0.25));
    }
    50% { 
      transform: rotate(-3deg) translateY(-1px);
      filter: drop-shadow(0 0 5px rgba(212, 160, 58, 0.7))
              drop-shadow(0 0 10px rgba(212, 160, 58, 0.4));
    }
  }

  /* Genre Toggle Buttons */
  .genre-toggle {
    display: flex;
    background: var(--bg-deep, #0a0c0e);
    border: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .genre-btn {
    position: relative;
    background: transparent;
    border: none;
    color: var(--text-secondary, rgba(255, 255, 255, 0.5));
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 1;
  }

  .genre-btn:first-child {
    border-right: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
  }

  .genre-btn:hover:not(.active) {
    color: var(--text-primary, rgba(255, 255, 255, 0.85));
    background: rgba(255, 255, 255, 0.03);
  }

  /* Hip-hop active state - green phosphor */
  .genre-btn[data-genre="hip-hop"].active {
    color: var(--phosphor-bright, #66ff66);
    background: rgba(51, 255, 51, 0.12);
    text-shadow: 0 0 8px rgba(51, 255, 51, 0.5);
    box-shadow: inset 0 0 12px rgba(51, 255, 51, 0.1);
  }

  /* Country active state - amber glow */
  .genre-btn[data-genre="country"].active {
    color: #e8b84a;
    background: rgba(212, 160, 58, 0.12);
    text-shadow: 0 0 8px rgba(212, 160, 58, 0.5);
    box-shadow: inset 0 0 12px rgba(212, 160, 58, 0.1);
  }

  .genre-btn-text {
    position: relative;
    z-index: 1;
  }

  /* Active indicator bar */
  .genre-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  .genre-btn[data-genre="hip-hop"].active::after {
    background: linear-gradient(90deg, transparent, var(--phosphor-base, #33ff33), transparent);
    box-shadow: 0 0 8px rgba(51, 255, 51, 0.6);
  }

  .genre-btn[data-genre="country"].active::after {
    background: linear-gradient(90deg, transparent, #d4a03a, transparent);
    box-shadow: 0 0 8px rgba(212, 160, 58, 0.6);
  }

  .queue-count {
    font-size: 0.75rem;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .queue-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 400px;
    overflow-y: auto;
    transition: all 0.3s ease;
    padding: 0.5rem;
    border-radius: 8px;
    background: transparent;
  }

  /* Country theme - amber glow styling */
  .queue-list.country-theme {
    background: rgba(255, 176, 0, 0.02);
    box-shadow: 
      0 0 12px rgba(255, 176, 0, 0.04),
      inset 0 0 8px rgba(255, 176, 0, 0.02);
  }

  .queue-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(51, 255, 51, 0.03);
    border: 1px solid rgba(51, 255, 51, 0.1);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .queue-list.country-theme .queue-item {
    background: rgba(255, 176, 0, 0.03);
    border: 1px solid rgba(255, 176, 0, 0.1);
  }

  .queue-item:hover {
    background: rgba(51, 255, 51, 0.08);
    border-color: rgba(51, 255, 51, 0.25);
  }

  .queue-list.country-theme .queue-item:hover {
    background: rgba(255, 176, 0, 0.06);
    border-color: rgba(255, 176, 0, 0.18);
  }

  .queue-item.active {
    background: rgba(51, 255, 51, 0.12);
    border-color: rgba(51, 255, 51, 0.3);
  }

  .queue-list.country-theme .queue-item.active {
    background: rgba(255, 176, 0, 0.08);
    border-color: rgba(255, 176, 0, 0.2);
  }

  .queue-item-number {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(51, 255, 51, 0.5);
    min-width: 24px;
    text-align: center;
    transition: color 0.15s ease;
  }

  /* Hip-hop: active number is amber (complementary) */
  .queue-item.active .queue-item-number {
    color: #e8b84a;
  }

  /* Country: non-active number is amber, active is green */
  .queue-list.country-theme .queue-item-number {
    color: rgba(212, 160, 58, 0.5);
  }

  .queue-list.country-theme .queue-item.active .queue-item-number {
    color: var(--phosphor-bright, #66ff66);
  }

  .queue-item-title {
    flex: 1;
    font-size: 0.9rem;
    color: rgba(51, 255, 51, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease, text-shadow 0.15s ease;
    cursor: pointer;
  }

  .queue-item-title:hover {
    color: var(--phosphor-bright, #66ff66);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.6);
  }

  /* Hip-hop: active title is amber (complementary) */
  .queue-item.active .queue-item-title {
    color: #e8b84a;
    font-weight: 600;
    text-shadow: 0 0 10px rgba(212, 160, 58, 0.5);
  }

  /* Country theme: non-active titles are amber */
  .queue-list.country-theme .queue-item-title {
    color: rgba(212, 160, 58, 0.7);
  }

  .queue-list.country-theme .queue-item-title:hover {
    color: #e8b84a;
    text-shadow: 0 0 10px rgba(212, 160, 58, 0.6);
  }

  /* Country: active title is green (complementary) */
  .queue-list.country-theme .queue-item.active .queue-item-title {
    color: var(--phosphor-bright, #66ff66);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.5);
  }

  .queue-item-genre-badge {
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Scrollbar */
  .queue-list::-webkit-scrollbar {
    width: 6px;
  }

  .queue-list::-webkit-scrollbar-track {
    background: var(--bg-surface);
    border-radius: 3px;
  }

  .queue-list::-webkit-scrollbar-thumb {
    background: var(--border-base);
    border-radius: 3px;
  }

  /* Lyrics styles for hero-right column */
  .lyrics-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-secondary);
    font-style: italic;
    opacity: 0.5;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }

  .lyrics-line {
    margin: 0.5rem 0;
    padding: 0.35rem 0.75rem;
    color: rgba(255, 255, 255, 0.45);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid transparent;
    font-weight: 400;
    border-radius: 0 4px 4px 0;
    position: relative;
  }

  /* Upcoming lines - slightly brighter than passed */
  .lyrics-line:not(.active) {
    opacity: 0.7;
  }

  .lyrics-line.lyrics-spacer {
    margin: 1.5rem 0;
    height: 0;
    padding: 0;
    border-left: none;
  }

  .lyrics-line.lyrics-header,
  .lyrics-container h3.lyrics-header {
    color: var(--amber-bright, #ffcc00);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 3px;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0;
    border-left: none;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-shadow: 0 0 12px rgba(255, 176, 0, 0.5);
    opacity: 1 !important;
  }

  /* Decorative line after section headers */
  .lyrics-container h3.lyrics-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(255, 176, 0, 0.5) 0%,
      rgba(51, 255, 51, 0.15) 60%,
      transparent 100%
    );
    box-shadow: 0 0 6px rgba(255, 176, 0, 0.25);
  }

  .lyrics-container h3.lyrics-header:first-child {
    margin-top: 0;
  }

  .lyrics-container h3 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  /* Active lyric line - the star of the show */
  .lyrics-line.active {
    color: #ffffff;
    font-weight: 500;
    border-left-color: var(--phosphor-base, #33ff33);
    background: linear-gradient(
      90deg,
      rgba(51, 255, 51, 0.12) 0%,
      rgba(51, 255, 51, 0.04) 50%,
      transparent 100%
    );
    text-shadow: 
      0 0 20px rgba(51, 255, 51, 0.6),
      0 0 40px rgba(51, 255, 51, 0.3);
    transform: translateX(4px);
    opacity: 1;
  }

  /* Active header styling */
  .lyrics-header.active {
    color: var(--phosphor-bright, #66ff66) !important;
    text-shadow: 
      0 0 15px rgba(51, 255, 51, 0.7),
      0 0 30px rgba(51, 255, 51, 0.4) !important;
  }

  /* Glow animation for active line */
  @keyframes lyricGlow {
    0%, 100% {
      text-shadow: 
        0 0 20px rgba(51, 255, 51, 0.6),
        0 0 40px rgba(51, 255, 51, 0.3);
    }
    50% {
      text-shadow: 
        0 0 25px rgba(51, 255, 51, 0.8),
        0 0 50px rgba(51, 255, 51, 0.4);
    }
  }

  .lyrics-line.active {
    animation: lyricGlow 2s ease-in-out infinite;
  }

  /* Responsive - Tablet: stack columns */
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      min-height: auto;
      height: auto;
    }

    .hero-right {
      border-left: none;
      border-top: 1px solid rgba(51, 255, 51, 0.15);
      padding-left: 0;
      padding-top: 1.5rem;
      height: 280px;
      max-height: 280px;
    }

    .lyrics-panel {
      height: 100%;
    }

    .lyrics-scroll-track {
      left: 0;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .hero-content {
      padding: 1rem;
      gap: 1.5rem;
    }

    .hero-now-playing {
      min-height: auto;
    }

    .hero-title {
      font-size: 1.5rem;
    }

    .hero-subtitle {
      font-size: 0.75rem;
    }

    .now-playing-card {
      padding: 0.75rem 1rem;
    }

    .track-title {
      font-size: 0.95rem;
    }

    .player-container {
      padding: 1rem;
      margin-top: 0.75rem;
    }

    .control-btn {
      padding: 0.5rem;
      font-size: 1rem;
    }

    .play-btn {
      width: 48px;
      height: 48px;
      font-size: 1.25rem;
    }

    .volume-percent {
      min-width: 35px;
    }

    .queue-section {
      padding: 1rem;
    }

    .queue-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .queue-header-right {
      width: 100%;
      justify-content: space-between;
    }

    .queue-list {
      max-height: 300px;
    }

    .lyrics-panel {
      position: static;
      width: 100%;
      max-height: 350px;
      margin-top: 1.5rem;
    }

    .lyrics-panel-inner {
      max-height: 350px;
    }

    .lyrics-panel-header {
      padding: 0.75rem 1rem;
    }

    .lyrics-content {
      padding: 1rem;
      line-height: 1.8;
      font-size: 0.85rem;
    }

    .lyrics-content h3.lyrics-header {
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }
  }

  /* Hotkeys Modal */
  .hotkeys-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .hotkeys-modal.visible {
    opacity: 1;
    visibility: visible;
  }

  .hotkeys-content {
    background: linear-gradient(135deg, var(--bg-elevated, #1a1d21) 0%, var(--bg-deep, #0d0f12) 100%);
    border: 1px solid rgba(51, 255, 51, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
    max-width: 420px;
    width: 90%;
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(51, 255, 51, 0.1);
    transform: scale(0.95);
    transition: transform 0.2s ease;
  }

  .hotkeys-modal.visible .hotkeys-content {
    transform: scale(1);
  }

  .hotkeys-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(51, 255, 51, 0.15);
  }

  .hotkeys-header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--phosphor-base, #33ff33);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.4);
    letter-spacing: 0.5px;
  }

  .hotkeys-close {
    background: transparent;
    border: none;
    color: var(--text-secondary, rgba(255, 255, 255, 0.5));
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .hotkeys-close:hover {
    color: var(--phosphor-base, #33ff33);
  }

  .hotkeys-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .hotkey-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgba(51, 255, 51, 0.04);
    border-radius: 6px;
    border: 1px solid rgba(51, 255, 51, 0.08);
  }

  .hotkey-item kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 28px;
    padding: 0 0.5rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(51, 255, 51, 0.3);
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--phosphor-bright, #66ff66);
    text-shadow: 0 0 6px rgba(51, 255, 51, 0.5);
    box-shadow: 
      0 2px 0 rgba(51, 255, 51, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3);
  }

  .hotkey-item span {
    font-size: 0.8rem;
    color: var(--text-primary, rgba(255, 255, 255, 0.85));
  }

  @media (max-width: 480px) {
    .hotkeys-grid {
      grid-template-columns: 1fr;
    }

    .hotkeys-content {
      padding: 1rem;
    }
  }

  /* Terminal Modal - Single Line Prompt */
  .terminal-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .terminal-modal.visible {
    opacity: 1;
    visibility: visible;
  }

  .terminal-prompt-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(51, 255, 51, 0.4);
    border-radius: 8px;
    padding: 1rem 1.5rem;
    width: 90%;
    max-width: 500px;
    box-shadow: 
      0 10px 40px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(51, 255, 51, 0.2),
      inset 0 1px 0 rgba(51, 255, 51, 0.1);
    transform: translateY(-10px);
    transition: transform 0.15s ease;
  }

  .terminal-modal.visible .terminal-prompt-bar {
