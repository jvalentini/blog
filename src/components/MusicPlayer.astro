    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn .play-icon,
  .play-btn .pause-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .progress-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .time-display {
    font-size: 0.75rem;
    color: var(--phosphor-base);
    min-width: 35px;
    text-align: center;
  }

  .progress-slider {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: rgba(51, 255, 51, 0.15);
    appearance: none;
    cursor: pointer;
  }

  .progress-slider::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--phosphor-base);
    cursor: pointer;
  }

  .volume-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

