---
import { promises as fs } from 'fs';
import * as path from 'path';

// Get all music files from the music folder
const musicDir = new URL('../assets/music', import.meta.url);
let musicFiles: Array<{name: string; mtime: number; path: string}> = [];

try {
  const files = await fs.readdir(musicDir);

  // Filter for audio files and get their stats
  musicFiles = await Promise.all(
    files
      .filter(f => f.match(/\.(mp3|wav)$/i))
      .map(async (file) => {
        const filePath = path.join(musicDir.pathname, file);
        const stats = await fs.stat(filePath);
        return {
          name: file,
          mtime: stats.mtimeMs,
          path: `/assets/music/${file}`
        };
      })
  );
} catch (err) {
  console.error('Failed to read music directory:', err);
}

// Helper function to generate URL-friendly slugs
function generateSlug(text: string): string {
  return text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '') // Remove special characters
    .replace(/[\s_-]+/g, '-') // Replace spaces, underscores, and hyphens with single hyphen
    .replace(/^-+|-+$/g, ''); // Remove leading/trailing hyphens
}

// Sort by newest first
const tracks = musicFiles
  .sort((a, b) => b.mtime - a.mtime)
  .map((f, idx) => {
    // Clean up filename for display
    const cleanName = f.name
      .replace(/\.(mp3|wav)$/i, '')
      .replace(/\(\d+\)/g, '')
      .trim();
    
    return {
      id: `track-${idx}`,
      title: cleanName,
      slug: generateSlug(cleanName),
      file: f.name,
      src: f.path
    };
  });
---

<div class="music-player">
  <div class="player-container">
    <!-- Now Playing Section -->
    <div class="now-playing-section">
      <div class="now-playing-label">♫ Now Playing</div>
      <div class="now-playing-display">
        <div class="track-title" id="current-track-title">Select a track</div>
        <div class="track-duration-display">
          <span id="current-time-np">0:00</span> / <span id="duration-time-np">0:00</span>
        </div>
      </div>
    </div>

    <!-- Hidden audio element -->
    <audio id="audio-player" preload="metadata"></audio>

    <!-- Main Player Controls -->
    <div class="player-controls">
      <!-- Top row: Previous, Shuffle, Play, Repeat, Next -->
      <div class="playback-buttons">
        <button class="control-btn" id="btn-previous" title="Previous track">
          <span class="btn-icon">⏮</span>
        </button>
        <button class="control-btn shuffle-btn" id="btn-shuffle" title="Toggle shuffle">
          <span class="btn-icon">🔀</span>
        </button>
        <button class="control-btn play-btn" id="btn-play" title="Play/Pause">
          <span class="btn-icon play-icon">▶</span>
          <span class="btn-icon pause-icon" style="display: none;">⏸</span>
        </button>
        <button class="control-btn repeat-btn" id="btn-repeat" title="Toggle repeat">
          <span class="btn-icon">🔁</span>
        </button>
        <button class="control-btn" id="btn-next" title="Next track">
          <span class="btn-icon">⏭</span>
        </button>
      </div>

      <!-- Progress bar with time display -->
      <div class="progress-section">
        <span class="time-display" id="current-time">0:00</span>
        <input
          type="range"
          id="progress-slider"
          class="progress-slider"
          min="0"
          max="100"
          value="0"
          aria-label="Track progress"
        />
        <span class="time-display" id="duration-time">0:00</span>
      </div>

      <!-- Volume Control with Block Segments -->
      <div class="volume-control">
        <label for="volume-slider" class="volume-label">vol:</label>
        <div class="volume-blocks">
          <div class="volume-block" data-level="1"></div>
          <div class="volume-block" data-level="2"></div>
          <div class="volume-block" data-level="3"></div>
          <div class="volume-block" data-level="4"></div>
          <div class="volume-block" data-level="5"></div>
          <div class="volume-block" data-level="6"></div>
          <div class="volume-block" data-level="7"></div>
          <div class="volume-block" data-level="8"></div>
          <div class="volume-block" data-level="9"></div>
          <div class="volume-block" data-level="10"></div>
        </div>
        <input
          type="range"
          id="volume-slider"
          class="volume-slider"
          min="0"
          max="100"
          value="70"
          aria-label="Volume"
        />
        <span class="volume-percent" id="volume-percent">70%</span>
      </div>
    </div>
  </div>

  <!-- Queue/Playlist Section -->
  <div class="queue-section">
    <div class="queue-header">
      <h3 class="queue-title">Queue</h3>
      <span class="queue-count" id="queue-count">0 tracks</span>
    </div>
    <div class="queue-list" id="queue-list">
      <!-- Tracks will be populated here -->
    </div>
  </div>
</div>

<script define:vars={{ tracks: JSON.stringify(tracks) }}>
  const audio = document.getElementById('audio-player');
  const btnPlay = document.getElementById('btn-play');
  const btnNext = document.getElementById('btn-next');
  const btnPrevious = document.getElementById('btn-previous');
  const btnShuffle = document.getElementById('btn-shuffle');
  const btnRepeat = document.getElementById('btn-repeat');
  const progressSlider = document.getElementById('progress-slider');
  const volumeSlider = document.getElementById('volume-slider');
  const currentTrackTitle = document.getElementById('current-track-title');
  const currentTimeNp = document.getElementById('current-time-np');
  const durationTimeNp = document.getElementById('duration-time-np');
  const currentTime = document.getElementById('current-time');
  const durationTime = document.getElementById('duration-time');
  const volumePercent = document.getElementById('volume-percent');
  const queueList = document.getElementById('queue-list');
  const queueCount = document.getElementById('queue-count');
  const playIcon = btnPlay.querySelector('.play-icon');
  const pauseIcon = btnPlay.querySelector('.pause-icon');

  // Parse tracks from server-side variable
  let allTracks = JSON.parse(tracks);
  let currentIndex = 0;
  let shuffleEnabled = false;
  let repeatMode = 0; // 0: no repeat, 1: repeat all, 2: repeat one
  let originalQueue = [...allTracks]; // Always newest to oldest, never changes
  let currentTrackIdInOriginal = null; // Track ID in originalQueue when shuffling

  // localStorage keys
  const STORAGE_KEY_SHUFFLE = 'musicplayer_shuffle';
  const STORAGE_KEY_REPEAT = 'musicplayer_repeat';
  const STORAGE_KEY_QUEUE = 'musicplayer_queue';

  // Save state to localStorage
  function saveState() {
    localStorage.setItem(STORAGE_KEY_SHUFFLE, JSON.stringify(shuffleEnabled));
    localStorage.setItem(STORAGE_KEY_REPEAT, JSON.stringify(repeatMode));
    localStorage.setItem(STORAGE_KEY_QUEUE, JSON.stringify({
      queue: allTracks,
      originalQueue: originalQueue,
      currentIndex: currentIndex
    }));
  }

  // Load state from localStorage
  function loadState() {
    const savedShuffle = localStorage.getItem(STORAGE_KEY_SHUFFLE);
    const savedRepeat = localStorage.getItem(STORAGE_KEY_REPEAT);
    const savedQueue = localStorage.getItem(STORAGE_KEY_QUEUE);

    if (savedShuffle !== null) {
      shuffleEnabled = JSON.parse(savedShuffle);
      btnShuffle.classList.toggle('active', shuffleEnabled);
    }

    if (savedRepeat !== null) {
      repeatMode = JSON.parse(savedRepeat);
      btnRepeat.classList.toggle('active', repeatMode > 0);
      if (repeatMode === 2) {
        btnRepeat.textContent = '🔂';
      }
    }

    if (savedQueue !== null) {
      try {
        const queueData = JSON.parse(savedQueue);
        allTracks = queueData.queue;
        originalQueue = queueData.originalQueue || [...allTracks];
        currentIndex = queueData.currentIndex || 0;
        
        // Restore currentTrackIdInOriginal if shuffling
        if (shuffleEnabled && allTracks.length > 0) {
          if (currentIndex < allTracks.length) {
            currentTrackIdInOriginal = allTracks[currentIndex]?.id || null;
          } else if (allTracks.length > 0) {
            currentTrackIdInOriginal = allTracks[0]?.id || null;
            currentIndex = 0;
          }
        }
      } catch (e) {
        console.error('Failed to restore queue:', e);
      }
    }
  }

  function formatTime(seconds) {
    if (!isFinite(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  // Update URL with song slug
  function updateURL(track) {
    if (!track || !track.slug) return;
    const newURL = `/waves/${track.slug}`;
    if (window.location.pathname !== newURL) {
      window.history.pushState({ trackSlug: track.slug }, '', newURL);
    }
  }

  // Load track by slug
  function loadTrackBySlug(slug) {
    // First check in allTracks
    let trackIndex = allTracks.findIndex(t => t.slug === slug);
    if (trackIndex !== -1) {
      loadTrack(trackIndex);
      return true;
    }
    
    // If not found, check in originalQueue (for shuffle mode)
    const originalIndex = originalQueue.findIndex(t => t.slug === slug);
    if (originalIndex !== -1) {
      const track = originalQueue[originalIndex];
      if (shuffleEnabled) {
        currentTrackIdInOriginal = track.id;
        audio.src = track.src;
        currentTrackTitle.textContent = track.title;
        updateQueueDisplay();
        updateURL(track);
        return true;
      } else {
        // Find in allTracks by ID
        trackIndex = allTracks.findIndex(t => t.id === track.id);
        if (trackIndex !== -1) {
          loadTrack(trackIndex);
          return true;
        }
      }
    }
    
    return false;
  }

  function loadTrack(index) {
    if (allTracks.length === 0) return;
    currentIndex = Math.max(0, Math.min(index, allTracks.length - 1));
    const track = allTracks[currentIndex];
    audio.src = track.src;
    currentTrackTitle.textContent = track.title;
    
    // Track current song in originalQueue when shuffling
    if (shuffleEnabled && track) {
      currentTrackIdInOriginal = track.id;
    }
    
    // Update URL
    updateURL(track);
    
    updateQueueDisplay();
  }

  function playTrack() {
    audio.play();
    playIcon.style.display = 'none';
    pauseIcon.style.display = 'inline';
  }

  function pauseTrack() {
    audio.pause();
    playIcon.style.display = 'inline';
    pauseIcon.style.display = 'none';
  }

  function playNext() {
    if (allTracks.length === 0) return;
    
    if (shuffleEnabled) {
      // Shuffle mode: pick random next song from originalQueue
      const availableTracks = originalQueue.filter(t => t.id !== currentTrackIdInOriginal);
      if (availableTracks.length === 0) {
        // All songs played, pick any random song
        const randomTrack = originalQueue[Math.floor(Math.random() * originalQueue.length)];
        currentTrackIdInOriginal = randomTrack.id;
        const trackIndex = originalQueue.findIndex(t => t.id === randomTrack.id);
        audio.src = originalQueue[trackIndex].src;
        currentTrackTitle.textContent = originalQueue[trackIndex].title;
        updateURL(randomTrack); // Update URL
        updateQueueDisplay();
        playTrack();
        saveState();
        return;
      }
      const nextTrack = availableTracks[Math.floor(Math.random() * availableTracks.length)];
      currentTrackIdInOriginal = nextTrack.id;
      const trackIndex = originalQueue.findIndex(t => t.id === nextTrack.id);
      audio.src = originalQueue[trackIndex].src;
      currentTrackTitle.textContent = originalQueue[trackIndex].title;
      updateURL(nextTrack); // Update URL
      updateQueueDisplay();
      playTrack();
      saveState();
      return;
    }
    
    if (repeatMode === 1) {
      // Repeat all: ring buffer - move current to end
      const currentTrack = allTracks[currentIndex];
      allTracks.splice(currentIndex, 1);
      allTracks.push(currentTrack);
      currentIndex = 0; // Next song is now at index 0
      loadTrack(0);
      playTrack();
      saveState();
      return;
    }
    
    // No shuffle, no repeat: queue behavior - remove from front
    allTracks.shift();
    if (allTracks.length === 0) {
      // Queue is empty
      audio.pause();
      pauseTrack();
      // Update URL back to /waves
      if (window.location.pathname.startsWith('/waves/')) {
        window.history.pushState({}, '', '/waves');
      }
      updateQueueDisplay();
      saveState();
      return;
    }
    currentIndex = 0; // Next song is now at index 0
    loadTrack(0);
    playTrack();
    saveState();
  }

  function playPrevious() {
    if (allTracks.length === 0) return;
    if (audio.currentTime > 3) {
      audio.currentTime = 0;
      saveState();
      return;
    }
    
    if (shuffleEnabled) {
      // Shuffle mode: pick random previous song (or just restart current)
      audio.currentTime = 0;
      saveState();
      return;
    }
    
    if (repeatMode === 1) {
      // Repeat all: move last song to front
      const lastTrack = allTracks.pop();
      if (lastTrack) {
        allTracks.unshift(lastTrack);
        currentIndex = 0;
        loadTrack(0);
        playTrack();
        saveState();
      }
      return;
    }
    
    // No shuffle, no repeat: can't go back in queue
    audio.currentTime = 0;
    saveState();
  }

  function toggleShuffle() {
    shuffleEnabled = !shuffleEnabled;
    btnShuffle.classList.toggle('active', shuffleEnabled);
    
    if (shuffleEnabled) {
      // Entering shuffle: restore originalQueue order, track current song
      const currentTrack = allTracks[currentIndex];
      allTracks = [...originalQueue];
      if (currentTrack) {
        currentTrackIdInOriginal = currentTrack.id;
        const trackIndex = originalQueue.findIndex(t => t.id === currentTrack.id);
        if (trackIndex !== -1) {
          audio.src = originalQueue[trackIndex].src;
          currentTrackTitle.textContent = originalQueue[trackIndex].title;
        }
      } else if (allTracks.length > 0) {
        // No current track, pick first one
        currentTrackIdInOriginal = allTracks[0].id;
        audio.src = allTracks[0].src;
        currentTrackTitle.textContent = allTracks[0].title;
      }
      updateQueueDisplay();
    } else {
      // Exiting shuffle: restore queue behavior based on repeat mode
      if (repeatMode === 1) {
        // Ring buffer mode: keep current order
        const currentTrackId = currentTrackIdInOriginal || allTracks[currentIndex]?.id;
        if (currentTrackId) {
          const trackIndex = originalQueue.findIndex(t => t.id === currentTrackId);
          if (trackIndex !== -1) {
            // Rebuild ring buffer starting from current track
            allTracks = [
              ...originalQueue.slice(trackIndex),
              ...originalQueue.slice(0, trackIndex)
            ];
            currentIndex = 0;
          }
        }
      } else {
        // Queue mode: show remaining songs
        const currentTrackId = currentTrackIdInOriginal || allTracks[currentIndex]?.id;
        if (currentTrackId) {
          const trackIndex = originalQueue.findIndex(t => t.id === currentTrackId);
          if (trackIndex !== -1) {
            // Show remaining songs (from current onwards)
            allTracks = originalQueue.slice(trackIndex);
            currentIndex = 0;
          }
        }
      }
      currentTrackIdInOriginal = null;
      loadTrack(currentIndex);
    }
    saveState();
  }

  function toggleRepeat() {
    repeatMode = (repeatMode + 1) % 3;
    btnRepeat.classList.toggle('active', repeatMode > 0);
    if (repeatMode === 2) {
      btnRepeat.textContent = '🔂';
    } else {
      btnRepeat.innerHTML = '<span class="btn-icon">🔁</span>';
    }
    saveState();
  }

  function updateQueueDisplay() {
    queueList.innerHTML = '';
    
    let displayTracks = [];
    let activeIndex = -1;
    
    if (shuffleEnabled) {
      // Shuffle mode: show originalQueue order, highlight current
      displayTracks = [...originalQueue];
      if (currentTrackIdInOriginal) {
        activeIndex = originalQueue.findIndex(t => t.id === currentTrackIdInOriginal);
      }
      queueCount.textContent = `${originalQueue.length} track${originalQueue.length !== 1 ? 's' : ''}`;
    } else {
      // Normal or repeat mode: show allTracks
      displayTracks = [...allTracks];
      activeIndex = currentIndex;
      queueCount.textContent = `${allTracks.length} track${allTracks.length !== 1 ? 's' : ''}`;
    }
    
    displayTracks.forEach((track, idx) => {
      const isActive = idx === activeIndex;
      const item = document.createElement('div');
      item.className = `queue-item ${isActive ? 'active' : ''}`;

      item.innerHTML = `
        <span class="queue-item-number">${idx + 1}</span>
        <span class="queue-item-title">${track.title}</span>
      `;
      queueList.appendChild(item);
      
      const titleElement = item.querySelector('.queue-item-title');
      
      // Make title clickable to play the song
      titleElement.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevent triggering the item click
        if (shuffleEnabled) {
          // In shuffle mode, just set the current track ID
          currentTrackIdInOriginal = track.id;
          audio.src = track.src;
          currentTrackTitle.textContent = track.title;
          updateURL(track); // Update URL
          updateQueueDisplay();
          playTrack();
          saveState();
        } else {
          currentIndex = idx;
          loadTrack(idx);
          playTrack();
          saveState();
        }
      });
      
      // Make entire queue item clickable to update URL (preview/share)
      item.addEventListener('click', (e) => {
        // Don't trigger if clicking the title (it has its own handler)
        if (e.target === titleElement || titleElement.contains(e.target)) {
          return;
        }
        // Clicking elsewhere on the item just updates URL (preview/share)
        updateURL(track);
      });
    });
  }

  // Event listeners
  btnPlay.addEventListener('click', () => {
    if (allTracks.length === 0) return;
    if (audio.paused) {
      if (!audio.src) loadTrack(0);
      playTrack();
    } else {
      pauseTrack();
    }
  });

  btnNext.addEventListener('click', playNext);
  btnPrevious.addEventListener('click', playPrevious);
  btnShuffle.addEventListener('click', toggleShuffle);
  btnRepeat.addEventListener('click', toggleRepeat);

  audio.addEventListener('timeupdate', () => {
    if (audio.duration) {
      const percent = (audio.currentTime / audio.duration) * 100;
      progressSlider.value = percent;
      currentTimeNp.textContent = formatTime(audio.currentTime);
      currentTime.textContent = formatTime(audio.currentTime);
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    durationTimeNp.textContent = formatTime(audio.duration);
    durationTime.textContent = formatTime(audio.duration);
  });

  audio.addEventListener('ended', () => {
    if (repeatMode === 2) {
      // Repeat one
      audio.currentTime = 0;
      playTrack();
    } else {
      playNext();
    }
  });

  progressSlider.addEventListener('change', () => {
    if (audio.duration) {
      audio.currentTime = (parseFloat(progressSlider.value) / 100) * audio.duration;
    }
  });

  volumeSlider.addEventListener('input', () => {
    const vol = parseFloat(volumeSlider.value);
    audio.volume = vol / 100;
    volumePercent.textContent = Math.round(vol) + '%';
    
    // Update volume blocks
    const filledBlocks = Math.ceil((vol / 100) * 10);
    document.querySelectorAll('.volume-block').forEach((block, idx) => {
      if (idx < filledBlocks) {
        block.classList.add('active');
      } else {
        block.classList.remove('active');
      }
    });
  });

  // Handle browser back/forward navigation
  window.addEventListener('popstate', (e) => {
    const path = window.location.pathname;
    const slugMatch = path.match(/^\/waves\/(.+)$/);
    
    if (slugMatch) {
      const slug = slugMatch[1];
      loadTrackBySlug(slug);
    } else if (path === '/waves' || path === '/waves/') {
      // Back to waves page, load first track
      if (allTracks.length > 0) {
        loadTrack(0);
      }
    }
  });

  // Initialize
  audio.volume = 0.7;
  loadState();
  updateQueueDisplay();
  
  // Initialize volume blocks (70%)
  const initialFilledBlocks = Math.ceil((70 / 100) * 10);
  document.querySelectorAll('.volume-block').forEach((block, idx) => {
    if (idx < initialFilledBlocks) {
      block.classList.add('active');
    }
  });
  
  // Volume blocks interaction
  let isDraggingVolume = false;
  
  function setVolumeFromBlock(block) {
    const level = parseInt(block.getAttribute('data-level'));
    const newVolume = (level / 10) * 100;
    volumeSlider.value = newVolume;
    audio.volume = level / 10;
    volumePercent.textContent = Math.round(newVolume) + '%';
    
    // Update blocks
    document.querySelectorAll('.volume-block').forEach((b, idx) => {
      if (idx < level) {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    });
  }
  
  document.querySelectorAll('.volume-block').forEach(block => {
    block.addEventListener('mousedown', (e) => {
      isDraggingVolume = true;
      setVolumeFromBlock(block);
    });
    
    block.addEventListener('mouseover', (e) => {
      if (isDraggingVolume) {
        setVolumeFromBlock(block);
      }
    });
    
    block.addEventListener('click', () => {
      setVolumeFromBlock(block);
    });
  });
  
  document.addEventListener('mouseup', () => {
    isDraggingVolume = false;
  });
  
  // Check URL on page load
  const path = window.location.pathname;
  const slugMatch = path.match(/^\/waves\/(.+)$/);
  
  if (slugMatch) {
    // URL has a slug, try to load that track
    const slug = slugMatch[1];
    const loaded = loadTrackBySlug(slug);
    if (!loaded) {
      // Slug not found, load first track and update URL
      if (allTracks.length > 0) {
        loadTrack(0);
      }
    }
  } else {
    // No slug in URL, auto-load the first (most recent) track
    if (allTracks.length > 0) {
      loadTrack(0);
    }
  }
</script>

<style>
  .music-player {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 100%;
  }

  @keyframes scanlines {
    0% {
      opacity: 0.03;
    }
    50% {
      opacity: 0.05;
    }
    100% {
      opacity: 0.03;
    }
  }

  @keyframes glow-pulse {
    0%, 100% {
      box-shadow: 
        0 10px 40px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(51, 255, 51, 0.05),
        0 0 20px rgba(51, 255, 51, 0.2);
    }
    50% {
      box-shadow: 
        0 10px 40px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(51, 255, 51, 0.05),
        0 0 40px rgba(51, 255, 51, 0.35);
    }
  }

  .player-container {
    background: linear-gradient(
      135deg,
      var(--bg-elevated) 0%,
      rgba(20, 25, 30, 0.8) 100%
    );
    border: 1px solid rgba(51, 255, 51, 0.2);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 
      0 15px 50px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(51, 255, 51, 0.08),
      0 0 40px rgba(51, 255, 51, 0.08);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(2px);
    animation: slideUp 0.6s ease-out;
  }

  .player-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      0deg,
      rgba(51, 255, 51, 0.03),
      rgba(51, 255, 51, 0.03) 1px,
      transparent 1px,
      transparent 2px
    );
    pointer-events: none;
    animation: scanlines 8s linear infinite;
    z-index: 10;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .player-container > * {
    position: relative;
    z-index: 11;
  }

  .now-playing-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(51, 255, 51, 0.15);
  }

  .now-playing-label {
    font-size: 0.7rem;
    color: rgba(255, 184, 77, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    margin-bottom: 1rem;
    text-shadow: 0 0 8px rgba(255, 184, 77, 0.2);
  }

  .now-playing-display {
