---
interface Props {
	title?: string;
	description?: string;
	turnstileSiteKey?: string;
}

const {
	title = 'Stay Updated',
	description = 'Get notified about new posts on software engineering, AI-assisted development, and modern web technologies. No spam, unsubscribe anytime.',
	turnstileSiteKey,
} = Astro.props;
---

<section class="newsletter">
	<div class="newsletter-header">
		<span class="prompt">$</span>
		<span class="command">newsletter --justin.valentini</span>
	</div>
	
	<p class="newsletter-description">{description}</p>
	
 	<form class="newsletter-form" action="/api/subscribe" method="POST" id="newsletter-form">
 		<div class="input-wrapper">
 			<span class="input-prefix">email:</span>
 			<input
 				type="email"
 				name="email"
 				placeholder="developer@example.com"
 				required
 				aria-label="Email address"
 			/>
 		</div>
		{turnstileSiteKey && (
			<!-- Optional spam protection - separate from Buttondown newsletter service -->
			<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-size="compact" data-action="newsletter-signup"></div>
		)}
 		<button type="submit" id="subscribe-btn">
 			<span class="btn-icon">></span>
 			<span class="btn-text">Subscribe</span>
 		</button>
 	</form>
	
	<p class="newsletter-status" id="newsletter-status" aria-live="polite"></p>
	
	<p class="newsletter-note">
		Powered by <a href="https://buttondown.com" target="_blank" rel="noopener">Buttondown</a>
	</p>
</section>

{turnstileSiteKey && (
	<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script is:inline>
	document.getElementById('newsletter-form')?.addEventListener('submit', async function(e) {
		e.preventDefault();
		
		const form = this;
		const status = document.getElementById('newsletter-status');
		const btn = document.getElementById('subscribe-btn');
		const btnText = btn?.querySelector('.btn-text');
		
		const formData = new FormData(form);
		const email = formData.get('email');
		const turnstileResponse = formData.get('cf-turnstile-response') || null;

		if (btnText) btnText.textContent = 'Subscribing...';
		if (btn) btn.disabled = true;
		if (status) {
			status.textContent = '';
			status.className = 'newsletter-status';
		}

		try {
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email, turnstileToken: turnstileResponse }),
			});

			const data = await res.json();
			
			if (data.success) {
				if (status) {
					status.textContent = data.message || 'Subscribed!';
					status.className = 'newsletter-status success';
				}
				form.reset();
				if (window.turnstile) window.turnstile.reset();
			} else {
				if (status) {
					status.textContent = data.error || 'Something went wrong';
					status.className = 'newsletter-status error';
				}
			}
		} catch (err) {
			if (status) {
				status.textContent = 'Network error. Please try again.';
				status.className = 'newsletter-status error';
			}
		} finally {
			if (btnText) btnText.textContent = 'Subscribe';
			if (btn) btn.disabled = false;
		}
	});
</script>

<style>
	.newsletter {
		background-color: var(--bg-surface);
		border: 1px solid var(--border-dim);
		border-radius: 8px;
		padding: var(--space-xl);
		margin: var(--space-2xl) 0;
	}

	.newsletter-header {
		display: flex;
		gap: var(--space-sm);
		margin-bottom: var(--space-md);
		font-size: var(--font-size-lg);
	}

	.prompt {
		color: var(--phosphor-base);
	}

	.command {
		color: var(--text-primary);
	}

	.newsletter-description {
		color: var(--text-secondary);
		margin-bottom: var(--space-lg);
		font-size: var(--font-size-sm);
	}

	.newsletter-form {
		display: flex;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.input-wrapper {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		flex: 1;
		min-width: 200px;
		padding: var(--space-sm) var(--space-md);
		background-color: var(--bg-deep);
		border: 1px solid var(--border-base);
		border-radius: 4px;
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.input-wrapper:focus-within {
		border-color: var(--phosphor-base);
		box-shadow: var(--glow-sm);
	}

	.input-prefix {
		color: var(--text-muted);
		font-size: var(--font-size-sm);
	}

	.newsletter-form input {
		flex: 1;
		background: transparent;
		border: none;
		color: var(--text-primary);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		outline: none;
	}

	.newsletter-form input::placeholder {
		color: var(--text-muted);
	}

	.newsletter-form button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		padding: var(--space-sm) var(--space-lg);
		background-color: transparent;
		border: 1px solid var(--phosphor-base);
		border-radius: 4px;
		color: var(--phosphor-base);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 500;
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.newsletter-form button:hover {
		background-color: var(--phosphor-base);
		color: var(--bg-base);
		box-shadow: var(--glow-md);
	}

	.btn-icon {
		font-size: var(--font-size-xs);
	}

	.newsletter-note {
		font-size: var(--font-size-xs);
		color: var(--text-muted);
		margin-top: var(--space-md);
		margin-bottom: 0;
	}

	.newsletter-note a {
		color: var(--text-secondary);
		text-decoration: underline;
		text-decoration-color: var(--border-dim);
	}

	.newsletter-note a:hover {
		color: var(--phosphor-base);
	}

	.newsletter-status {
		font-size: var(--font-size-sm);
		margin-top: var(--space-md);
		margin-bottom: 0;
		min-height: 1.5em;
	}

	.newsletter-status.success {
		color: var(--phosphor-base);
	}

	.newsletter-status.error {
		color: #ef4444;
	}

	.cf-turnstile {
		margin: var(--space-sm) 0;
	}

	.newsletter-form button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	@media (max-width: 720px) {
		.newsletter-form {
			flex-direction: column;
		}

		.newsletter-form button {
			width: 100%;
			justify-content: center;
		}
	}
</style>
