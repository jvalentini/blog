  // Matrix rain effect
  function triggerMatrixRain() {
    closeTerminal();
    const canvas = document.createElement('canvas');
    canvas.id = 'matrix-canvas';
    canvas.style.cssText = 'position:fixed;inset:0;z-index:9998;background:#000;';
    document.body.appendChild(canvas);
    
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789';
    const fontSize = 14;
    const columns = canvas.width / fontSize;
    const drops: number[] = Array(Math.floor(columns)).fill(1);
    
    let frameCount = 0;
    const maxFrames = 180;
    
    function draw() {
      if (!ctx) return;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      ctx.fillStyle = '#0f0';
      ctx.font = fontSize + 'px monospace';
      
      for (let i = 0; i < drops.length; i++) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * fontSize, drops[i] * fontSize);
        
        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }
      
      frameCount++;
      if (frameCount < maxFrames) {
        requestAnimationFrame(draw);
      } else {
        canvas.remove();
      }
    }
    draw();
  }

  // System destruction Easter egg
  function triggerDestruction() {
    closeTerminal();
    
    const overlay = document.getElementById('destruction-overlay');
    const terminal = document.getElementById('destruction-terminal');
    const biosScreen = document.getElementById('bios-screen');
    const biosLoading = document.getElementById('bios-loading');
    
    if (!overlay || !terminal) return;
    
    overlay.classList.add('active');
    
    const messages = [
      { text: 'rm: removing /home/guest/music/*', delay: 0 },
      { text: 'rm: removing /var/log/*', delay: 400 },
      { text: 'rm: removing /usr/share/sounds/*', delay: 700 },
      { text: 'rm: removing /etc/passwd', delay: 1000 },
      { text: 'rm: WARNING: removing system files', delay: 1300 },
      { text: 'rm: removing /boot/vmlinuz', delay: 1600 },
      { text: 'rm: removing /bin/bash', delay: 1900 },
      { text: 'KERNEL PANIC - not syncing: Attempted to kill init!', delay: 2300 },
      { text: '---[ end Kernel panic ]---', delay: 2600 },
    ];

    // Start deleting page elements
    setTimeout(() => {
      const elements = document.querySelectorAll('header, footer, main > *:not(.destruction-overlay)');
      let i = 0;
      const deleteInterval = setInterval(() => {
        if (i < elements.length) {
          const el = elements[i] as HTMLElement;
          el.style.transition = 'all 0.3s ease';
          el.style.transform = 'scale(0.95) translateY(10px)';
          el.style.opacity = '0';
          el.style.filter = 'blur(4px)';
          i++;
        } else {
          clearInterval(deleteInterval);
        }
      }, 200);
    }, 500);

    // Display destruction messages
    messages.forEach(({ text, delay }) => {
      setTimeout(() => {
        const line = document.createElement('div');
        line.className = 'destruction-line';
        line.textContent = text;
        terminal.appendChild(line);
        terminal.scrollTop = terminal.scrollHeight;
      }, delay);
    });

    // Show BIOS after destruction
    setTimeout(() => {
      terminal.style.display = 'none';
      if (biosScreen) biosScreen.classList.add('active');
      
      const loadingSteps = [
        'Memory OK: 640K base, 32768K extended',
        'CPU: Quantum i9-9900K @ 4.20GHz',
        'Initializing USB controllers... Done',
        'Loading justin.sys...',
        'Restoring user data...',
        'System restored successfully.',
        '',
        'Just kidding. Everything is fine. 😈',
      ];
      
      let step = 0;
      const loadingInterval = setInterval(() => {
        if (step < loadingSteps.length && biosLoading) {
          const line = document.createElement('p');
          line.textContent = loadingSteps[step];
          biosLoading.appendChild(line);
          step++;
        } else {
          clearInterval(loadingInterval);
          
          setTimeout(() => {
            const elements = document.querySelectorAll('header, footer, main > *');
            elements.forEach(el => {
              const htmlEl = el as HTMLElement;
              htmlEl.style.transition = 'all 0.5s ease';
              htmlEl.style.transform = '';
              htmlEl.style.opacity = '';
              htmlEl.style.filter = '';
            });
            
            overlay.classList.remove('active');
            terminal.style.display = '';
            terminal.innerHTML = '';
            if (biosScreen) biosScreen.classList.remove('active');
            if (biosLoading) biosLoading.innerHTML = '';
          }, 2500);
        }
      }, 400);
    }, 3200);
  }

  // Linux-style tab completion system
  // Track double-tab for showing all options
  let lastTabTime = 0;
  let lastTabInput = '';
  const DOUBLE_TAB_THRESHOLD = 500; // ms

  // Base commands for completion
  const baseCommands = [
    'help', 'cd', 'ls', 'cat', 'open', 'clear', 'exit',
    'play', 'pause', 'next', 'prev', 'volume', 'queue',
    'shuffle', 'repeat', 'mute', 'loop', 'info', 'nowplaying',
    'whoami', 'pwd', 'date', 'uptime', 'uname',
    'cowsay', 'matrix', 'neofetch', 'sl', 'echo', 'hack', 'history',
    'sudo', 'fortune', 'ping', 'man', 'top', 'ps', 'free', 'df',
  ];

  // Cat command completions: about, posts/, waves/
  const catTargets = ['about', 'posts/', 'waves/'];

  // Find longest common prefix among strings
  function findCommonPrefix(strings: string[]): string {
    if (strings.length === 0) return '';
    if (strings.length === 1) return strings[0];
    
    let prefix = strings[0];
    for (let i = 1; i < strings.length; i++) {
      while (!strings[i].startsWith(prefix) && prefix.length > 0) {
        prefix = prefix.slice(0, -1);
      }
    }
    return prefix;
  }

  // Get completions for current input
  function getCompletions(input: string): string[] {
    const lower = input.toLowerCase();
    const parts = lower.split(/\s+/);
    const command = parts[0];
    const args = parts.slice(1).join(' ');

    // Empty or partial command - complete command name
    if (parts.length === 1 && !lower.endsWith(' ')) {
      return baseCommands.filter(cmd => cmd.startsWith(lower));
    }

    // cat command completions
    if (command === 'cat') {
      // "cat " or "cat <partial>"
      if (args === '' || !args.includes('/')) {
        // Show cat targets (about, posts/, waves/)
        const matchingTargets = catTargets.filter(t => t.startsWith(args));
        return matchingTargets.map(t => `cat ${t}`);
      }
      
      // "cat posts/" or "cat posts/<partial>"
      if (args.startsWith('posts/')) {
        const partial = args.slice(6); // remove "posts/"
        const matches = blogSlugs.filter(s => s.startsWith(partial));
        return matches.map(s => `cat posts/${s}`);
      }
      
      // "cat waves/" or "cat waves/<partial>"
      if (args.startsWith('waves/')) {
        const partial = args.slice(6); // remove "waves/"
        const matches = songSlugs.filter(s => s.startsWith(partial));
        return matches.map(s => `cat waves/${s}`);
      }
    }

    // ls command completions
    if (command === 'ls') {
      const lsTargets = ['posts', 'waves'];
      if (args === '') {
        return lsTargets.map(t => `ls ${t}`);
      }
      const matches = lsTargets.filter(t => t.startsWith(args));
      return matches.map(t => `ls ${t}`);
    }

    // cd command completions
    if (command === 'cd') {
      const cdTargets = ['~', 'posts', 'waves', 'about'];
      if (args === '') {
        return cdTargets.map(t => `cd ${t}`);
      }
      const matches = cdTargets.filter(t => t.startsWith(args));
      return matches.map(t => `cd ${t}`);
    }

    // open command completions
    if (command === 'open') {
      const openTargets = ['about', 'blog', 'waves', 'home'];
      if (args === '') {
        return openTargets.map(t => `open ${t}`);
      }
      const matches = openTargets.filter(t => t.startsWith(args));
      return matches.map(t => `open ${t}`);
    }

    return [];
  }

  // Handle tab completion - returns { completed: string, showOptions: boolean }
  function handleTabCompletion(input: string, isDoubleTab: boolean): { completed: string; showOptions: string[] } {
    const completions = getCompletions(input);
    
    if (completions.length === 0) {
      return { completed: input, showOptions: [] };
    }
    
    if (completions.length === 1) {
      // Single match - complete it
      return { completed: completions[0], showOptions: [] };
    }
    
    // Multiple matches
    const commonPrefix = findCommonPrefix(completions);
    
    if (isDoubleTab || commonPrefix === input) {
      // Double tab or can't extend further - show all options
      return { completed: commonPrefix, showOptions: completions };
    }
    
    // Single tab with common prefix - extend to common prefix
    return { completed: commonPrefix, showOptions: [] };
  }

  // Terminal input handling
  if (terminalInput) {
    terminalInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const cmd = terminalInput.value;
        if (cmd.trim()) {
          terminalHistory.push(cmd);
          historyIndex = terminalHistory.length;
        }
        processCommand(cmd);
        terminalInput.value = '';
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const now = Date.now();
        const currentInput = terminalInput.value;
        
        // Check for double-tab
        const isDoubleTab = (now - lastTabTime < DOUBLE_TAB_THRESHOLD) && (lastTabInput === currentInput);
        lastTabTime = now;
        lastTabInput = currentInput;
        
        const result = handleTabCompletion(currentInput, isDoubleTab);
        
        // Update input with completion
        if (result.completed !== currentInput) {
          terminalInput.value = result.completed;
          lastTabInput = result.completed; // Update for next double-tab check
        }
        
        // Show options if double-tab revealed them
        if (result.showOptions.length > 0) {
          clearTerminalOutput();
          // Format options nicely - extract just the argument part for display
          const options = result.showOptions.map(opt => {
            const parts = opt.split(' ');
            return parts.length > 1 ? parts.slice(1).join(' ') : opt;
          });
          // Display in columns
          const perRow = 3;
          for (let i = 0; i < options.length; i += perRow) {
            const row = options.slice(i, i + perRow);
            print(row.map(o => `<span class="ls-file">${o}</span>`).join('  '));
          }
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          terminalInput.value = terminalHistory[historyIndex] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < terminalHistory.length - 1) {
          historyIndex++;
          terminalInput.value = terminalHistory[historyIndex] || '';
        } else {
          historyIndex = terminalHistory.length;
          terminalInput.value = '';
        }
      } else if (e.key === 'Escape') {
        closeTerminal();
      }
      e.stopPropagation();
    });

    terminalInput.addEventListener('keyup', function(e) {
      e.stopPropagation();
    });
  }

  // Close on backdrop click
  if (terminalModal) {
    terminalModal.addEventListener('click', function(e) {
      if (e.target === terminalModal) {
        closeTerminal();
      }
    });
  }

  // Konami code detection: ↑ ↑ ↓ ↓ ← → ← → B A
  const konamiSequence = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let konamiIndex = 0;

  function checkKonamiCode(key: string) {
    const expected = konamiSequence[konamiIndex];
    if (key === expected || key === expected.toUpperCase()) {
      konamiIndex++;
      if (konamiIndex === konamiSequence.length) {
        konamiIndex = 0;
        triggerKonamiEasterEgg();
      }
    } else {
      konamiIndex = 0;
    }
  }

  function triggerKonamiEasterEgg() {
    // 30 lives! Classic Contra reference
    const overlay = document.createElement('div');
    overlay.className = 'konami-overlay';
    overlay.innerHTML = `
      <div class="konami-content">
        <div class="konami-text">+30 LIVES</div>
        <div class="konami-subtext">↑↑↓↓←→←→BA</div>
      </div>
    `;
    document.body.appendChild(overlay);

    // Remove after animation
    setTimeout(() => {
      overlay.classList.add('fade-out');
      setTimeout(() => overlay.remove(), 500);
    }, 2500);
  }

  // Global keyboard shortcuts
  document.addEventListener('keydown', function(e) {
    // Ignore if typing in input fields
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || (e.target as HTMLElement).isContentEditable) {
      return;
    }

    // Check Konami code first (before other shortcuts)
    checkKonamiCode(e.key);

    if (e.key === '/') {
      e.preventDefault();
      openTerminal();
    } else if (e.key === 'Escape') {
      closeTerminal();
    }
  });

  // Expose terminal API globally
  (window as any).terminalAPI = {
    open: openTerminal,
    close: closeTerminal,
  };
</script>

