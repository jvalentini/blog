---
// Terminal Component - Global terminal accessible from any page
// Music player integration is optional - works standalone on non-music pages

import { getCollection } from 'astro:content';
import tracksData from '../data/tracks.json';

// Fetch blog post slugs at build time
const allPosts = await getCollection('blog');
const blogSlugs = allPosts
	.filter((post) => !post.data.draft)
	.map((post) => post.id)
	.sort();

// Get song slugs from tracks data
const songSlugs = tracksData.songs.map((song: { id: string }) => song.id).sort();
---

<!-- Terminal Data (injected at build time) -->
<script id="terminal-data" type="application/json" set:html={JSON.stringify({ blogSlugs, songSlugs })}></script>

<!-- Terminal Modal - Single Line Prompt -->
<div class="terminal-modal" id="terminal-modal">
  <div class="terminal-output-popup" id="terminal-output"></div>
  <div class="terminal-prompt-bar">
    <span class="terminal-prompt-full"><span class="terminal-user">justin.valentini</span><span class="terminal-at">@</span><span class="terminal-host">blog</span><span class="terminal-colon">:</span><span class="terminal-path">~</span><span class="terminal-prompt-symbol">$</span></span>
    <input type="text" class="terminal-input" id="terminal-input" autocomplete="off" spellcheck="false" placeholder="type 'help' for commands" />
  </div>
</div>

<!-- System Destruction Overlay (Easter Egg) -->
<div class="destruction-overlay" id="destruction-overlay">
  <div class="destruction-terminal" id="destruction-terminal"></div>
  <div class="bios-screen" id="bios-screen">
    <div class="bios-logo">
      <pre>
 █     █░ ▄▄▄    ██▒   █▓▓█████   ██████ 
▓█░ █ ░█░▒████▄ ▓██░   █▒▓█   ▀ ▒██    ▒ 
▒█░ █ ░█ ▒██  ▀█▄▓██  █▒░▒███   ░ ▓██▄   
░█░ █ ░█ ░██▄▄▄▄██▒██ █░░▒▓█  ▄   ▒   ██▒
░░██▒██▓  ▓█   ▓██▒▒▀█░  ░▒████▒▒██████▒▒
░ ▓░▒ ▒   ▒▒   ▓▒█░░ ▐░  ░░ ▒░ ░▒ ▒▓▒ ▒ ░
  ▒ ░ ░    ▒   ▒▒ ░░ ░░   ░ ░  ░░ ░▒  ░ ░
  ░   ░    ░   ▒     ░░     ░   ░  ░  ░  
    ░          ░  ░   ░     ░  ░      ░  
      </pre>
    </div>
    <div class="bios-text">
      <p>BIOS v4.20.69</p>
      <p>Detecting hardware...</p>
      <p class="bios-loading" id="bios-loading"></p>
    </div>
  </div>
</div>

<script>
  // Terminal Module - Works globally, integrates with music player when available
  
  // Load dynamic data injected at build time
  const terminalDataEl = document.getElementById('terminal-data');
  const terminalData = terminalDataEl ? JSON.parse(terminalDataEl.textContent || '{}') : { blogSlugs: [], songSlugs: [] };
  const blogSlugs: string[] = terminalData.blogSlugs || [];
  const songSlugs: string[] = terminalData.songSlugs || [];

  interface MusicPlayerAPI {
    playNext: () => void;
    playPrevious: () => void;
    pauseAudio: () => void;
    playAudio: () => void;
    setVolume: (level: number) => void;
    toggleShuffle: () => void;
    toggleRepeat: () => void;
    getState: () => {
      currentIndex: number;
      currentGenre: string;
      currentTrackTitle: string | null;
      currentTime: string;
      duration: string;
      volume: number;
      shuffleEnabled: boolean;
      repeatMode: string;
      queueTitles: string[];
    };
  }
  
  // Global music player API - set by MusicPlayer component when present
  declare global {
    interface Window {
      musicPlayerAPI?: MusicPlayerAPI;
    }
  }

  const terminalModal = document.getElementById('terminal-modal');
  const terminalInput = document.getElementById('terminal-input') as HTMLInputElement | null;
  const terminalOutput = document.getElementById('terminal-output');
  const terminalUserEl = document.querySelector('.terminal-user') as HTMLElement | null;
  const terminalPromptSymbol = document.querySelector('.terminal-prompt-symbol') as HTMLElement | null;
  const terminalHost = document.querySelector('.terminal-host') as HTMLElement | null;
  
  let terminalHistory: string[] = [];
  let historyIndex = -1;
  let isRoot = false;

  // Update host based on current page
  function updateHost() {
    if (terminalHost) {
      const path = window.location.pathname;
      if (path.startsWith('/waves')) {
        terminalHost.textContent = 'waves';
      } else if (path.startsWith('/blog')) {
        terminalHost.textContent = 'blog';
      } else if (path === '/about') {
        terminalHost.textContent = 'about';
      } else {
        terminalHost.textContent = 'blog';
      }
    }
  }

  function updateTerminalPrompt() {
    if (terminalUserEl) {
      terminalUserEl.textContent = isRoot ? 'root' : 'justin.valentini';
      terminalUserEl.style.color = isRoot ? '#ff3333' : '';
    }
    if (terminalPromptSymbol) {
      terminalPromptSymbol.textContent = isRoot ? '#' : '$';
    }
  }

  function openTerminal() {
    if (terminalModal) {
      updateHost();
      terminalModal.classList.add('visible');
      setTimeout(() => {
        if (terminalInput) {
          terminalInput.focus();
        }
      }, 50);
    }
  }

  function closeTerminal() {
    if (terminalModal) {
      terminalModal.classList.remove('visible');
      clearTerminalOutput();
      if (terminalInput) terminalInput.value = '';
    }
  }

  function clearTerminalOutput() {
    if (terminalOutput) {
      terminalOutput.innerHTML = '';
      terminalOutput.classList.remove('has-content');
    }
  }

  function addTerminalLine(text: string) {
    if (!terminalOutput) return;
    const line = document.createElement('div');
    line.className = 'terminal-line';
    line.innerHTML = text;
    terminalOutput.appendChild(line);
    terminalOutput.classList.add('has-content');
    terminalOutput.scrollTop = terminalOutput.scrollHeight;
  }

  function print(...lines: string[]) {
    for (const text of lines) {
      addTerminalLine(text);
    }
  }

  function navigate(path: string, message?: string) {
    if (message) addTerminalLine(message);
    setTimeout(() => { window.location.href = path; }, 300);
  }

  // Check if music player is available
  function hasMusicPlayer(): boolean {
    return typeof window.musicPlayerAPI !== 'undefined';
  }

  function formatTime(seconds: number): string {
    if (!isFinite(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return mins + ':' + secs.toString().padStart(2, '0');
  }

  function processCommand(cmd: string) {
    const trimmed = cmd.trim().toLowerCase();
    const parts = trimmed.split(/\s+/);
    const command = parts[0];
    const args = parts.slice(1).join(' ');

    clearTerminalOutput();

    // === HELP ===
    if (trimmed === 'help') {
      print('<span class="cmd">cd</span> · <span class="cmd">ls</span> · <span class="cmd">cat</span> · <span class="cmd">open</span> · <span class="cmd">clear</span> · <span class="cmd">exit</span>');
      if (hasMusicPlayer()) {
        print('<span class="cmd">play</span> · <span class="cmd">pause</span> · <span class="cmd">next</span> · <span class="cmd">prev</span> · <span class="cmd">volume</span> · <span class="cmd">queue</span>');
        print('<span class="cmd">&lt;/&gt;</span> · <span class="cmd">mute</span> · <span class="cmd">loop</span> · <span class="cmd">info</span> · <span class="cmd">shuffle</span> · <span class="cmd">repeat</span>');
      }
      return;
    }

    if (trimmed === '') return;

    // === NAVIGATION ===
    if (trimmed === 'cd' || trimmed === 'cd home' || trimmed === 'cd ~' || trimmed === 'cd /') {
      navigate('/', 'Navigating to home...');
    } else if (trimmed === 'cd posts' || trimmed === 'cd posts/' || trimmed === 'cd blog' || trimmed === 'cd blog/') {
      navigate('/blog', 'Navigating to posts...');
    } else if (trimmed === 'cd waves' || trimmed === 'cd waves/' || trimmed === 'cd music' || trimmed === 'cd music/') {
      navigate('/waves', 'Navigating to waves...');
    } else if (trimmed === 'cd about' || trimmed === 'cd about/') {
      navigate('/about', 'Navigating to about...');
    } else if (command === 'cd') {
      print(`bash: cd: ${args}: No such directory. Try: ~, posts, waves, about`);
    }
    // === LS ===
    else if (trimmed === 'ls') {
      print('<span class="ls-dir">posts/</span>  <span class="ls-dir">waves/</span>  <span class="ls-file">about.txt</span>  <span class="ls-file">README.md</span>');
    } else if (trimmed === 'ls posts' || trimmed === 'ls posts/' || trimmed === 'ls blog' || trimmed === 'ls blog/') {
      // Dynamic blog post listing
      const postFiles = blogSlugs.map(s => `<span class="ls-file">${s}.md</span>`);
      for (let i = 0; i < postFiles.length; i += 3) {
        print(postFiles.slice(i, i + 3).join('  '));
      }
    } else if (trimmed === 'ls waves' || trimmed === 'ls waves/' || trimmed === 'ls music' || trimmed === 'ls music/') {
      // Dynamic song listing
      const songFiles = songSlugs.map(s => `<span class="ls-file">${s}.mp3</span>`);
      for (let i = 0; i < songFiles.length; i += 3) {
        print(songFiles.slice(i, i + 3).join('  '));
      }
    } else if (command === 'ls') {
      print(`ls: cannot access '${args}': No such file or directory`);
    }
    // === CAT ===
    else if (trimmed === 'cat about' || trimmed === 'cat about.txt') {
      navigate('/about', 'Opening about...');
    } else if (trimmed === 'cat readme.md' || trimmed === 'cat readme') {
      print('# justin.blog - Personal blog and music. Press / for terminal, ? for shortcuts.');
    } else if (trimmed === 'cat /etc/passwd') {
      print(
        'root:x:0:0:root:/root:/bin/bash',
        'daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin',
        'bin:x:2:2:bin:/bin:/usr/sbin/nologin',
        'sys:x:3:3:sys:/dev:/usr/sbin/nologin',
        'www-data:x:33:33:www-data:/var/www:/usr/sbin/nologin',
        'justin.valentini:x:1000:1000:Justin Valentini:/home/justin.valentini:/bin/bash',
        'postgres:x:109:117:PostgreSQL administrator:/var/lib/postgresql:/bin/bash',
        'node:x:1001:1001:Node.js:/home/node:/bin/bash'
      );
    } else if (trimmed === 'cat /etc/shadow') {
      print(
        'root:$6$rounds=656000$saltsalt:18945:0:99999:7:::',
        'justin.valentini:$6$yourmom$notactuallyhashed:19847:0:99999:7:::',
        'cat: /etc/shadow: Nice try reading the shadow file 😏'
      );
    } else if (command === 'cat') {
      // Handle cat posts/<slug> and cat waves/<slug>
      let catArg = args;
      
      // Check for posts/ prefix
      if (catArg.startsWith('posts/')) {
        const slug = catArg.slice(6).replace(/\.md$/, '');
        if (blogSlugs.includes(slug)) {
          navigate(`/blog/${slug}`, `Opening ${slug}...`);
        } else {
          print(`cat: ${args}: No such file or directory`);
        }
      }
      // Check for waves/ prefix
      else if (catArg.startsWith('waves/')) {
        const slug = catArg.slice(6).replace(/\.mp3$/, '');
        if (songSlugs.includes(slug)) {
          navigate(`/waves/${slug}`, `Opening ${slug}...`);
        } else {
          print(`cat: ${args}: No such file or directory`);
        }
      }
      // Legacy: bare slug (check blog first, then waves)
      else {
        const slug = catArg.replace(/\.md$/, '').replace(/\.mp3$/, '');
        if (blogSlugs.includes(slug)) {
          navigate(`/blog/${slug}`, `Opening ${slug}...`);
        } else if (songSlugs.includes(slug)) {
          navigate(`/waves/${slug}`, `Opening ${slug}...`);
        } else {
          print(`cat: ${args}: No such file or directory`);
        }
      }
    }
    // === OPEN ===
    else if (command === 'open') {
      const pages: Record<string, string> = { 'about': '/about', 'blog': '/blog', 'posts': '/blog', 'waves': '/waves', 'home': '/', '~': '/' };
      const openArg = args.replace(/\.mp3$/, '').replace(/^waves\//, '');
      if (pages[args]) {
        navigate(pages[args], `Opening ${args}...`);
      } else if (blogSlugs.includes(openArg)) {
        navigate(`/blog/${openArg}`, `Opening ${openArg}...`);
      } else if (args) {
        print(`open: ${args}: not found. Try: about, blog, waves, home`);
      } else {
        print('Usage: open <page>');
      }
    }
    // === CLEAR/EXIT ===
    else if (trimmed === 'clear') {
      clearTerminalOutput();
    } else if (trimmed === 'exit' || trimmed === 'quit' || trimmed === 'q' || trimmed === 'logout') {
      if (isRoot) {
        isRoot = false;
        updateTerminalPrompt();
        print('logout', 'Returning to justin.valentini...');
      } else {
        closeTerminal();
      }
    }
    // === SUDO / ROOT ===
    else if (trimmed === 'sudo rm -rf /' || trimmed === 'sudo rm -rf /*' || (isRoot && (trimmed === 'rm -rf /' || trimmed === 'rm -rf /*'))) {
      triggerDestruction();
    } else if (trimmed === 'rm -rf /' || trimmed === 'rm -rf /*') {
      print('rm: cannot remove \'/\': Permission denied');
    } else if (command === 'rm' && !isRoot) {
      print(`rm: cannot remove '${args}': Permission denied`);
    } else if (command === 'rm' && isRoot) {
      print(`rm: removed '${args}'`);
    } else if (trimmed === 'sudo su' || trimmed === 'sudo -i' || trimmed === 'sudo bash' || trimmed === 'su' || trimmed === 'su -' || trimmed === 'sudo -s') {
      isRoot = true;
      updateTerminalPrompt();
      print('root@blog:~# You are now root. With great power comes great responsibility.');
    } else if (command === 'sudo') {
      print(`[sudo] password for justin.valentini:`);
      if (args) {
        const sudoCmd = args.trim();
        if (sudoCmd === 'rm -rf /' || sudoCmd === 'rm -rf /*') {
          triggerDestruction();
        } else {
          print(`Executed: ${sudoCmd}`);
        }
      }
    }
    // === MUSIC COMMANDS (only when player available) ===
    else if (trimmed === 'next' || trimmed === 'n') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.playNext();
        closeTerminal();
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'prev' || trimmed === 'previous' || trimmed === 'p') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.playPrevious();
        closeTerminal();
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'pause' || trimmed === 'stop') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.pauseAudio();
        print('Paused');
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'play' || trimmed === 'resume' || trimmed === 'unpause') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.playAudio();
        closeTerminal();
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (command === 'volume' || command === 'vol') {
      if (hasMusicPlayer()) {
        const state = window.musicPlayerAPI!.getState();
        const vol = parseInt(args);
        if (!isNaN(vol) && vol >= 0 && vol <= 100) {
          window.musicPlayerAPI!.setVolume(Math.round(vol / 10));
          print(`Volume: ${vol}%`);
        } else if (args === 'up') {
          const newVol = Math.min(10, Math.round(state.volume * 10) + 1);
          window.musicPlayerAPI!.setVolume(newVol);
          print(`Volume: ${newVol * 10}%`);
        } else if (args === 'down') {
          const newVol = Math.max(0, Math.round(state.volume * 10) - 1);
          window.musicPlayerAPI!.setVolume(newVol);
          print(`Volume: ${newVol * 10}%`);
        } else {
          print(`Volume: ${Math.round(state.volume * 100)}%`);
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'shuffle') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.toggleShuffle();
        const state = window.musicPlayerAPI!.getState();
        print(`Shuffle: ${state.shuffleEnabled ? 'on' : 'off'}`);
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'repeat') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.toggleRepeat();
        const state = window.musicPlayerAPI!.getState();
        print(`Repeat: ${state.repeatMode}`);
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'queue' || trimmed === 'playlist') {
      if (hasMusicPlayer()) {
        const state = window.musicPlayerAPI!.getState();
        state.queueTitles.forEach((title, idx) => {
          const marker = idx === state.currentIndex ? '▶ ' : '  ';
          print(`${marker}${idx + 1}. ${title}`);
        });
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'nowplaying' || trimmed === 'np') {
      if (hasMusicPlayer()) {
        const state = window.musicPlayerAPI!.getState();
        if (state.currentIndex >= 0 && state.currentTrackTitle) {
          print(`♫ ${state.currentTrackTitle} [${state.currentTime}/${state.duration}]`);
        } else {
          print('Nothing playing');
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    }
    // === ADVANCED MUSIC COMMANDS ===
    else if (command === 'seek') {
      if (hasMusicPlayer()) {
        print('Seek functionality coming soon! For now use the progress bar.');
        print('Try: seek +5, seek -10, seek 50%, seek 1:30');
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'mute' || trimmed === 'm') {
      if (hasMusicPlayer()) {
        const state = window.musicPlayerAPI!.getState();
        if (state.volume > 0) {
          window.musicPlayerAPI!.setVolume(0);
          print('🔇 Muted');
        } else {
          window.musicPlayerAPI!.setVolume(7); // Default volume
          print('🔊 Unmuted');
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'loop' || trimmed === 'repeat one' || trimmed === 'repeat-one') {
      if (hasMusicPlayer()) {
        window.musicPlayerAPI!.toggleRepeat();
        const state = window.musicPlayerAPI!.getState();
        if (state.repeatMode === 'one') {
          print('🔁 Loop: One track');
        } else {
          print(`🔁 Loop: ${state.repeatMode}`);
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'fullscreen' || trimmed === 'fs') {
      if (hasMusicPlayer()) {
        if (document.fullscreenElement) {
          document.exitFullscreen();
          print('Exited fullscreen');
        } else {
          document.documentElement.requestFullscreen();
          print('Entered fullscreen');
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (command === 'speed' || command === 'rate') {
      if (hasMusicPlayer()) {
        print('Playback speed control coming soon!');
        print('Try: speed 0.5, speed 1.25, speed 1.5, speed normal');
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'info' || trimmed === 'trackinfo') {
      if (hasMusicPlayer()) {
        const state = window.musicPlayerAPI!.getState();
        if (state.currentIndex >= 0 && state.currentTrackTitle) {
          print(`🎵 Track Info:`);
          print(`   Title: ${state.currentTrackTitle}`);
          print(`   Genre: ${state.currentGenre}`);
          print(`   Position: ${state.currentIndex + 1}/${state.queueTitles.length}`);
          print(`   Time: ${state.currentTime}/${state.duration}`);
          print(`   Volume: ${Math.round(state.volume * 10)}/10`);
          print(`   Shuffle: ${state.shuffleEnabled ? 'On' : 'Off'}`);
          print(`   Repeat: ${state.repeatMode}`);
        } else {
          print('No track currently playing');
        }
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'lyrics' || trimmed === 'lyric') {
      if (hasMusicPlayer()) {
        print('Lyrics toggle coming soon! (They\'re always visible for now)');
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === 'quality' || trimmed === 'q') {
      if (hasMusicPlayer()) {
        print('Audio quality: High (MP3)');
        print('Available formats: hip-hop, country versions');
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === '<' || trimmed === 'back' || trimmed === 'rewind') {
      if (hasMusicPlayer()) {
        print('⏪ Seeking backward 5 seconds...');
        // This would need seek API - for now just show it's coming
        setTimeout(() => print('Feature coming soon!'), 500);
      } else {
        print('Music player not available. Try: cd waves');
      }
    } else if (trimmed === '>' || trimmed === 'forward' || trimmed === 'ff') {
      if (hasMusicPlayer()) {
        print('⏩ Seeking forward 5 seconds...');
        // This would need seek API - for now just show it's coming
        setTimeout(() => print('Feature coming soon!'), 500);
      } else {
        print('Music player not available. Try: cd waves');
      }
    }

    // === INFO COMMANDS ===
    else if (trimmed === 'whoami') {
      print(isRoot ? 'root' : 'justin.valentini');
    } else if (trimmed === 'id') {
      print(isRoot
        ? 'uid=0(root) gid=0(root) groups=0(root)'
        : 'uid=1000(justin.valentini) gid=1000(justin.valentini) groups=1000(justin.valentini),27(sudo),docker');
    } else if (trimmed === 'pwd') {
      print(isRoot ? '/root' : '/home/justin.valentini' + window.location.pathname);
    } else if (trimmed === 'date') {
      print(new Date().toString());
    } else if (trimmed === 'uptime') {
      print(' ' + new Date().toLocaleTimeString() + ' up 42 days,  3:14,  1 user,  load average: 0.52, 0.58, 0.59');
    } else if (trimmed === 'uname' || trimmed === 'uname -a') {
      print('JustinOS 1.0.0 justin.blog x86_64 JavaScript/Vibes');
    } else if (command === 'groups') {
      print(isRoot ? 'root' : 'justin.valentini sudo docker');
    } else if (trimmed === 'w') {
      print(' 01:35:00 up 42 days,  3:14,  1 user,  load average: 0.52, 0.58, 0.59');
      print('USER     TTY      FROM             LOGIN@   IDLE   JCPU   PCPU WHAT');
      print('justin   pts/0    192.168.1.100    09:15   2:45   0.12s 0.08s w');
    }
    // === FILE SYSTEM OPERATIONS ===
    else if (command === 'cp') {
      if (args) {
        print(`cp: copied '${args}'`);
      } else {
        print('cp: missing file operand');
      }
    } else if (command === 'mv' || command === 'rename') {
      if (args) {
        print(`mv: renamed '${args}'`);
      } else {
        print('mv: missing file operand');
      }
    } else if (command === 'mkdir') {
      if (args) {
        print(`mkdir: created directory '${args}'`);
      } else {
        print('mkdir: missing operand');
      }
    } else if (command === 'rmdir') {
      if (args) {
        print(`rmdir: removed directory '${args}'`);
      } else {
        print('rmdir: missing operand');
      }
    } else if (trimmed === 'touch') {
      if (args) {
        print(`touch: updated timestamp for '${args}'`);
      } else {
        print('touch: missing file operand');
      }
    } else if (command === 'chmod') {
      if (args) {
        print(`chmod: changed permissions of '${args}'`);
      } else {
        print('chmod: missing operand');
      }
    }
    // === TEXT PROCESSING ===
    else if (command === 'grep') {
      if (args) {
        print(`grep: searching for '${args}'...`);
      } else {
        print('grep: missing pattern');
      }
    } else if (command === 'head') {
      if (args) {
        print(`==> ${args} <==`);
      } else {
        print('head: missing file operand');
      }
    } else if (command === 'tail') {
      if (args) {
