---
// No props needed - content populated by JS
---

<div class="lyrics-panel">
  <button class="lyrics-fullscreen-btn" id="lyrics-fullscreen-btn" title="Full screen lyrics">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </button>
  <div class="lyrics-scroll-track">
    <div class="lyrics-scroll-progress" id="lyrics-scroll-progress"></div>
  </div>
  <div class="lyrics-container" id="lyrics-content">
    <div class="lyrics-empty">
      <p>Select a track to view lyrics</p>
    </div>
  </div>
</div>

<!-- Fullscreen Lyrics Overlay -->
<div class="lyrics-fullscreen-overlay" id="lyrics-fullscreen-overlay">
  <button class="lyrics-fullscreen-close" id="lyrics-fullscreen-close" title="Exit full screen">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <div class="lyrics-fullscreen-track" id="lyrics-fullscreen-track">Now Playing</div>
  <div class="lyrics-fullscreen-content" id="lyrics-fullscreen-content"></div>
</div>

<style>
  /* Lyrics Panel - Distinctive scrolling lyrics display */
  .lyrics-panel {
    position: relative;
    flex: 1;
    display: flex;
    min-height: 0;
    overflow: hidden;
  }

  /* Vertical scroll progress track */
  .lyrics-scroll-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--genre-dim, rgba(51, 255, 51, 0.1));
    border-radius: 2px;
    z-index: 2;
  }

  .lyrics-scroll-progress {
    width: 100%;
    background: linear-gradient(
      180deg,
      var(--genre-base, var(--phosphor-base)) 0%,
      var(--genre-bright, var(--phosphor-bright)) 100%
    );
    border-radius: 2px;
    transition: height 0.3s ease-out;
    box-shadow: 0 0 8px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 40%, transparent);
  }

  .lyrics-container {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.75rem 1rem 1.25rem;
    color: var(--text-primary);
    line-height: 2;
    font-size: 0.95rem;
    scroll-behavior: smooth;
    /* Fade edges for scroll indication */
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  /* Hide default scrollbar - using custom progress track */
  .lyrics-container::-webkit-scrollbar {
    width: 0;
    display: none;
  }

  /* Lyrics empty state */
  .lyrics-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-secondary);
    font-style: italic;
    opacity: 0.5;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }

  /* Lyric line base styles */
  .lyrics-panel :global(.lyrics-line) {
    margin: 0.5rem 0;
    padding: 0.35rem 0.75rem;
    color: rgba(255, 255, 255, 0.45);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid transparent;
    font-weight: 400;
    border-radius: 0 4px 4px 0;
    position: relative;
  }

  /* Upcoming lines - slightly brighter than passed */
  .lyrics-panel :global(.lyrics-line:not(.active)) {
    opacity: 0.7;
  }

  .lyrics-panel :global(.lyrics-line.lyrics-spacer) {
    margin: 1.5rem 0;
    height: 0;
    padding: 0;
    border-left: none;
  }

  .lyrics-panel :global(.lyrics-line.lyrics-header),
  .lyrics-container :global(h3.lyrics-header) {
    color: var(--genre-bright, var(--phosphor-bright));
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 3px;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0;
    border-left: none;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-shadow: 0 0 12px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 50%, transparent);
    opacity: 1 !important;
  }

  /* Decorative line after section headers */
  .lyrics-container :global(h3.lyrics-header::after) {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 50%, transparent) 0%,
      color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 15%, transparent) 60%,
      transparent 100%
    );
    box-shadow: 0 0 6px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 25%, transparent);
  }

  .lyrics-container :global(h3.lyrics-header:first-child) {
    margin-top: 0;
  }

  .lyrics-container :global(h3) {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  /* Active lyric line - the star of the show */
  .lyrics-panel :global(.lyrics-line.active) {
    color: #ffffff;
    font-weight: 500;
    border-left-color: var(--genre-base, var(--phosphor-base));
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 12%, transparent) 0%,
      color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 4%, transparent) 50%,
      transparent 100%
    );
    text-shadow: 
      0 0 20px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 60%, transparent),
      0 0 40px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
    transform: translateX(4px);
    opacity: 1;
    animation: lyricGlow 2s ease-in-out infinite;
  }

  /* Active header styling */
  .lyrics-panel :global(.lyrics-header.active) {
    color: var(--genre-bright, var(--phosphor-bright)) !important;
    text-shadow: 
      0 0 15px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 70%, transparent),
      0 0 30px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 40%, transparent) !important;
  }

  /* Glow animation for active line */
  @keyframes lyricGlow {
    0%, 100% {
      text-shadow: 
        0 0 20px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 60%, transparent),
        0 0 40px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
    }
    50% {
      text-shadow: 
        0 0 25px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 80%, transparent),
        0 0 50px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 40%, transparent);
    }
  }

  /* Responsive - Tablet: stack columns */
  @media (max-width: 900px) {
    .lyrics-panel {
      height: 100%;
    }

    .lyrics-scroll-track {
      left: 0;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 600px) {
    .lyrics-panel {
      position: static;
      width: 100%;
      max-height: 350px;
      margin-top: 1.5rem;
    }

    .lyrics-container {
      padding: 1rem;
      line-height: 1.8;
      font-size: 0.85rem;
    }

    .lyrics-container :global(h3.lyrics-header) {
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }
  }

  /* Fullscreen Button */
  .lyrics-fullscreen-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid var(--genre-base, rgba(51, 255, 51, 0.3));
    color: var(--genre-base, #33ff33);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .lyrics-fullscreen-btn:hover {
    background: rgba(0, 0, 0, 0.7);
    border-color: var(--genre-base, rgba(51, 255, 51, 0.5));
  }

  @media (max-width: 768px) {
    .lyrics-fullscreen-btn {
      display: flex;
    }
  }

  /* Fullscreen Overlay */
  .lyrics-fullscreen-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(180deg, rgba(5, 8, 10, 0.98) 0%, rgba(10, 15, 20, 0.98) 100%);
    display: none;
    flex-direction: column;
    padding: 1rem;
    padding-top: env(safe-area-inset-top, 1rem);
    padding-bottom: env(safe-area-inset-bottom, 1rem);
  }

  .lyrics-fullscreen-overlay.visible {
    display: flex;
  }

  .lyrics-fullscreen-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .lyrics-fullscreen-track {
    text-align: center;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--genre-base, #33ff33);
    margin-bottom: 1rem;
    padding-top: 0.5rem;
  }

  .lyrics-fullscreen-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    font-size: 1.5rem;
    line-height: 2;
    color: rgba(255, 255, 255, 0.5);
    padding: 2rem 1rem;
    padding-top: 20vh;
    scroll-behavior: smooth;
  }

  .lyrics-fullscreen-content :global(.lyrics-line) {
    margin: 0.75rem 0;
    padding: 0.5rem 1rem;
    transition: all 0.4s ease;
    max-width: 90%;
  }

  .lyrics-fullscreen-content :global(.lyrics-line.active) {
    color: var(--genre-bright, #66ff66);
    font-size: 1.75rem;
    font-weight: 600;
    text-shadow: 
      0 0 30px var(--genre-base, #33ff33),
      0 0 60px var(--genre-base, #33ff33);
  }

  .lyrics-fullscreen-content :global(.lyrics-header) {
    color: var(--genre-base, #33ff33);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-top: 2rem;
    opacity: 0.8;
  }
</style>
