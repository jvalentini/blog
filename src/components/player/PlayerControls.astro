---
// No props needed - IDs are used for JS binding
---

<div class="playback-buttons">
  <div class="shuffle-control-wrapper">
    <span class="shuffle-mode-label" id="shuffle-mode-label"></span>
    <button class="control-btn" id="btn-shuffle" title="Shuffle: Off (S)">
      <svg class="shuffle-icon shuffle-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
      </svg>
      <svg class="shuffle-icon shuffle-tracks" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display: none;">
        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" fill="none" stroke="currentColor" stroke-width="2"/>
      </svg>
      <svg class="shuffle-icon shuffle-tracks-genres" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display: none;">
        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" fill="none" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
  </div>
  <button class="control-btn" id="btn-previous" title="Previous">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M6 5a1 1 0 0 1 1 1v4.08l8.38-4.77A1.08 1.08 0 0 1 17 6.25v11.5a1.08 1.08 0 0 1-1.62.94L7 13.92V18a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1Z"/>
    </svg>
  </button>
  <button class="control-btn play-btn" id="btn-play" title="Play/Pause">
    <span class="play-icon">&#9654;</span>
    <span class="pause-icon" style="display: none;">&#9208;</span>
  </button>
  <button class="control-btn" id="btn-next" title="Next">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M18 5a1 1 0 0 0-1 1v4.08L8.62 5.31A1.08 1.08 0 0 0 7 6.25v11.5a1.08 1.08 0 0 0 1.62.94L17 13.92V18a1 1 0 1 0 2 0V6a1 1 0 0 0-1-1Z"/>
    </svg>
  </button>
  <div class="repeat-control-wrapper">
    <span class="repeat-mode-label" id="repeat-mode-label"></span>
    <button class="control-btn" id="btn-repeat" title="Repeat (R)">
      <svg class="repeat-icon repeat-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 1l4 4-4 4"/>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
        <path d="M7 23l-4-4 4-4"/>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
      </svg>
      <svg class="repeat-icon repeat-all" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display: none;">
        <path d="M17 1l4 4-4 4"/>
        <path d="M3 11V9a4 4 0 0 1 4-4h14" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M7 23l-4-4 4-4"/>
        <path d="M21 13v2a4 4 0 0 1-4 4H3" fill="none" stroke="currentColor" stroke-width="2"/>
      </svg>
      <svg class="repeat-icon repeat-one" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display: none;">
        <path d="M17 1l4 4-4 4"/>
        <path d="M3 11V9a4 4 0 0 1 4-4h14" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M7 23l-4-4 4-4"/>
        <path d="M21 13v2a4 4 0 0 1-4 4H3" fill="none" stroke="currentColor" stroke-width="2"/>
        <text x="12" y="14" font-size="8" text-anchor="middle" fill="currentColor" stroke="none">1</text>
      </svg>
    </button>
  </div>
  <div class="download-controls">
    <div class="download-control-wrapper">
      <span class="download-status-label" id="download-status-label">Download</span>
      <button class="control-btn" id="btn-download" title="Download playlist">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v12" />
          <path d="M8 11l4 4 4-4" />
          <path d="M4 19h16" />
        </svg>
      </button>
    </div>
    <div class="remove-control-wrapper">
      <span class="remove-status-label" id="remove-status-label">Remove</span>
      <button class="control-btn" id="btn-remove-downloads" title="Remove downloads">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18" />
          <path d="M8 6V4h8v2" />
          <path d="M6 6l1 14h10l1-14" />
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .playback-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--genre-dim, rgba(51, 255, 51, 0.08));
    border: 1px solid color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 25%, transparent);
    color: var(--genre-base, var(--phosphor-base));
    padding: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 1rem;
    line-height: 1;
  }

  .control-btn:hover {
    border-color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 50%, transparent);
    background: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 15%, transparent);
  }

  .control-btn.active {
    background: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
    border-color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 70%, transparent);
    color: var(--genre-bright, var(--phosphor-bright));
    box-shadow: 
      0 0 16px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 50%, transparent),
      0 0 8px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
  }

  .control-btn svg {
    display: block;
  }

  .shuffle-control-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .shuffle-mode-label,
  .repeat-mode-label {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    min-height: 0.75rem;
    line-height: 1;
    opacity: 1;
    transition: color 0.2s ease;
  }

  .repeat-control-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .download-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .download-control-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .remove-control-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  #btn-shuffle,
  #btn-repeat {
    position: relative;
  }

  .download-status-label {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    min-height: 0.75rem;
    line-height: 1;
    opacity: 1;
    transition: color 0.2s ease;
  }

  .remove-status-label {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 60%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    min-height: 0.75rem;
    line-height: 1;
    opacity: 1;
    transition: color 0.2s ease;
  }

  #btn-download.downloading {
    animation: download-pulse 1.2s ease-in-out infinite;
  }

  .repeat-icon,
  .shuffle-icon {
    display: none;
  }

  .repeat-icon.repeat-off,
  .shuffle-icon.shuffle-off {
    display: block;
  }

  #btn-repeat.active .repeat-off { display: none; }
  #btn-repeat.active:not(.repeat-one) .repeat-all { display: block; }
  #btn-repeat.active:not(.repeat-one) .repeat-one { display: none; }
  #btn-repeat.active.repeat-one .repeat-all { display: none; }
  #btn-repeat.active.repeat-one .repeat-one { display: block; }

  #btn-shuffle.active .shuffle-off { display: none; }
  
  /* Show tracks icon when in tracks mode */
  #btn-shuffle.active:not(.shuffle-tracks-genres) .shuffle-tracks { display: block; }
  #btn-shuffle.active:not(.shuffle-tracks-genres) .shuffle-tracks-genres { display: none; }
  
  /* Show tracks+genres icon when in tracks+genres mode */
  #btn-shuffle.active.shuffle-tracks-genres .shuffle-tracks { display: none; }
  #btn-shuffle.active.shuffle-tracks-genres .shuffle-tracks-genres { display: block; }

  @keyframes download-pulse {
    0% {
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
    50% {
      box-shadow: 0 0 16px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 45%, transparent);
    }
    100% {
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
  }

  .play-btn {
    width: 56px;
    height: 56px;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn .play-icon,
  .play-btn .pause-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .control-btn {
      font-size: 1rem;
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
    }

    .playback-buttons {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .download-controls {
      flex-basis: 100%;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }

    .play-btn {
      width: 52px;
      height: 52px;
      font-size: 1.25rem;
    }
  }
</style>
