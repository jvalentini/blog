---
interface Playlist {
	id: string;
	artworkPath?: string;
	name: string;
	visible: boolean;
}

import { getYotoDisplayArtworkPath } from '../../utils/yoto-artwork';

interface Props {
	playlists: Record<string, Playlist>;
	defaultPlaylist: string;
}

const { playlists, defaultPlaylist } = Astro.props;
const playlistArray = Object.values(playlists);
---

<div class="playlist-selector">
	<div class="playlist-header">
		<div class="playlist-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M4 5h16M4 12h16M4 19h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				<path d="M18 17l2 2-2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</div>
		<div>
			<div class="playlist-label">Playlists</div>
			<div class="playlist-count">{playlistArray.filter((playlist) => playlist.visible).length} visible</div>
		</div>
	</div>
	<div class="playlist-toggle" role="radiogroup" aria-label="Select playlist">
		{playlistArray.map((playlist) => (
			<button
				class="playlist-btn"
				data-playlist-id={playlist.id}
				data-visible={playlist.visible}
				role="radio"
				aria-checked={playlist.id === defaultPlaylist ? 'true' : 'false'}
				aria-label={`${playlist.name} playlist`}
			>
				{playlist.artworkPath && (
					<img
						class="playlist-art"
						src={getYotoDisplayArtworkPath(playlist.artworkPath)}
						alt=""
						loading="lazy"
						width="34"
						height="34"
					/>
				)}
				<span>{playlist.name}</span>
			</button>
		))}
	</div>
	<div class="playlist-reveal-indicator" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<style>
/* ========================================
   PLAYLIST SELECTOR COMPONENT
   ======================================== */

.playlist-selector {
  display: flex;
  align-items: stretch;
  gap: 0.875rem;
  border: 1px solid rgba(51, 255, 51, 0.2);
  border-radius: 8px;
  padding: 0.75rem;
  background: rgba(0, 0, 0, 0.3);
  box-shadow: 0 0 8px rgba(51, 255, 51, 0.1);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.playlist-selector:hover {
  border-color: rgba(51, 255, 51, 0.4);
  box-shadow: 0 0 12px rgba(51, 255, 51, 0.2);
}

/* ========================================
   PLAYLIST ICON
   ======================================== */
.playlist-header {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  min-width: 8rem;
  flex: 0 0 8rem;
  padding: 0.375rem 0.25rem;
}

.playlist-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.playlist-icon svg {
  width: 24px;
  height: 24px;
  color: var(--phosphor-base, #33ff33);
  filter: drop-shadow(0 0 4px currentColor);
  transition: all 0.3s ease;
  animation: icon-pulse 2s ease-in-out infinite;
}

.playlist-label {
  color: var(--phosphor-base, #33ff33);
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.1;
  text-transform: uppercase;
}

.playlist-count {
  color: rgba(255, 255, 255, 0.48);
  font-size: 0.68rem;
  margin-top: 0.2rem;
}

@keyframes icon-pulse {
  0%, 100% { 
    filter: drop-shadow(0 0 4px currentColor);
  }
  50% { 
    filter: drop-shadow(0 0 6px currentColor)
            drop-shadow(0 0 10px currentColor);
  }
}

/* ========================================
   BUTTON GROUP CONTAINER
   ======================================== */
.playlist-toggle {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  background: var(--bg-deep, #0a0c0e);
  border: 1px solid rgba(51, 255, 51, 0.15);
  border-radius: 6px;
  overflow-x: hidden;
  overflow-y: auto;
  position: relative;
  max-height: min(21rem, 45vh);
  scrollbar-color: rgba(51, 255, 51, 0.35) rgba(0, 0, 0, 0.25);
  scrollbar-width: thin;
}

.playlist-toggle::-webkit-scrollbar {
  width: 0.5rem;
}

.playlist-toggle::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.25);
}

.playlist-toggle::-webkit-scrollbar-thumb {
  background: rgba(51, 255, 51, 0.35);
  border-radius: 999px;
}

/* ========================================
   PLAYLIST BUTTONS - BASE STYLES
   ======================================== */
.playlist-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.625rem;
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(51, 255, 51, 0.1);
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.5);
  min-height: 42px;
  padding: 0.625rem 0.875rem;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s ease;
  overflow-wrap: anywhere;
}

.playlist-art {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border: 1px solid rgba(51, 255, 51, 0.22);
  border-radius: 6px;
  object-fit: cover;
  box-shadow: 0 0 6px rgba(51, 255, 51, 0.12);
}

.playlist-btn span {
  min-width: 0;
}

.playlist-btn:last-child {
  border-bottom: none;
}

.playlist-btn[data-visible="false"] {
  display: none;
}

.playlist-btn[data-visible="false"].revealed {
  display: flex;
  animation: playlist-reveal 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.playlist-btn:hover {
  color: rgba(255, 255, 255, 0.8);
  background: rgba(51, 255, 51, 0.05);
}

.playlist-btn:focus-visible {
  outline: 2px solid rgba(51, 255, 51, 0.5);
  outline-offset: -2px;
  z-index: 1;
}

.playlist-btn[aria-checked="true"] {
  color: var(--phosphor-base, #33ff33);
  background: rgba(51, 255, 51, 0.1);
  box-shadow: 
    0 0 8px rgba(51, 255, 51, 0.3),
    inset 3px 0 0 0 rgba(51, 255, 51, 0.75);
}

@keyframes playlist-reveal {
  0% {
    opacity: 0;
    transform: translateX(-20px) scale(0.9);
    filter: blur(4px);
  }
  40% {
    opacity: 1;
    transform: translateX(0) scale(1);
    filter: blur(0);
  }
  50%, 70% {
    box-shadow: 0 0 20px rgba(51, 255, 51, 0.8);
  }
  100% {
    box-shadow: none;
  }
}

.playlist-reveal-indicator {
  position: absolute;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  height: 1px;
  overflow: hidden;
  white-space: nowrap;
  width: 1px;
}

/* ========================================
   RESPONSIVE - MOBILE
   ======================================== */
@media (max-width: 768px) {
  .playlist-selector {
    gap: 0.5rem;
  }

  .playlist-header {
    flex: 0 0 7.5rem;
    min-width: 7.5rem;
  }

  .playlist-toggle {
    max-height: 14rem;
  }

  .playlist-btn {
    min-height: 44px;
    padding: 0.625rem 0.75rem;
  }

  .playlist-label {
    font-size: 0.7rem;
  }
}

@media (max-width: 560px) {
  .playlist-selector {
    flex-direction: column;
  }

  .playlist-header {
    flex: initial;
    min-width: 0;
    padding: 0 0.125rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .playlist-icon svg {
    animation: none;
  }
  .playlist-btn[data-visible="false"].revealed {
    animation: none;
  }
  .playlist-btn {
    transition: none;
  }
}
</style>
