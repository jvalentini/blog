---
interface Props {
  tracks: Array<{
    id: number;
    songId: string;
    title: string;
    versions: Record<string, string>;
  }>;
  genres: string[];
  defaultGenre: string;
}

const { tracks, genres, defaultGenre } = Astro.props;
---

<div class="queue-section">
  <div class="queue-header">
    <h3 class="queue-title" id="queue-title">Queue</h3>
    <div class="queue-header-right">
      <div class="genre-selector">
        <!-- Genre Icon - generic icon for all genres -->
        <div class="genre-icon" id="genre-icon">
          <svg class="genre-icon-generic" id="genre-icon-generic" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Musical note icon -->
            <path d="M12 4 L12 20 C12 22.5 10 24.5 7.5 24.5 C5 24.5 3 22.5 3 20 C3 17.5 5 15.5 7.5 15.5 C8.5 15.5 9.5 15.8 10 16.2 L10 4 L12 4 Z" stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M20 4 L20 20 C20 22.5 22 24.5 24.5 24.5 C27 24.5 29 22.5 29 20 C29 17.5 27 15.5 24.5 15.5 C23.5 15.5 22.5 15.8 22 16.2 L22 4 L20 4 Z" stroke="currentColor" stroke-width="2" fill="none"/>
            <line x1="12" y1="4" x2="20" y2="4" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <!-- Genre Toggle Buttons -->
        <div class="genre-toggle" id="genre-toggle">
          {genres.map((genre) => {
            const genreDisplay = genre.split('-').map(word => 
              word.charAt(0).toUpperCase() + word.slice(1)
            ).join('-');
            return (
              <button 
                class={`genre-btn ${defaultGenre === genre ? 'active' : ''}`} 
                id={`genre-btn-${genre}`} 
                data-genre={genre}
              >
                <span class="genre-btn-text">{genreDisplay}</span>
              </button>
            );
          })}
        </div>
      </div>
      <span class="queue-count">{tracks.length} track{tracks.length !== 1 ? 's' : ''}</span>
    </div>
  </div>
  <div class="queue-list" id="queue-list">
    {tracks.map((track, idx) => (
      <div 
        class="queue-item" 
        data-index={idx}
        data-versions={JSON.stringify(track.versions)}
        data-title={track.title}
        data-song-id={track.songId}
      >
        <span class="queue-item-number">{idx + 1}</span>
        <span class="queue-item-title">{track.title}</span>
        <span class="queue-item-genre-badge" id={`genre-badge-${idx}`}></span>
      </div>
    ))}
  </div>
</div>

<style>
  /* Queue Section */
  .queue-section {
    background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(20, 25, 30, 0.7) 100%);
    border: 1px solid rgba(51, 255, 51, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .queue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--phosphor-dim);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .queue-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--phosphor-base);
    margin: 0;
    transition: color 0.3s ease, text-shadow 0.3s ease;
    text-shadow: 0 0 8px rgba(51, 255, 51, 0.3);
  }


  .queue-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .genre-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Genre Icon Container */
  .genre-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .genre-icon svg {
    width: 28px;
    height: 28px;
    transition: all 0.3s ease;
  }

  /* Generic genre icon - green terminal glow */
  .genre-icon-generic {
    color: var(--phosphor-base, #33ff33);
    filter: drop-shadow(0 0 4px rgba(51, 255, 51, 0.6))
            drop-shadow(0 0 8px rgba(51, 255, 51, 0.3));
    animation: icon-pulse 2s ease-in-out infinite;
  }

  @keyframes icon-pulse {
    0%, 100% { 
      filter: drop-shadow(0 0 4px rgba(51, 255, 51, 0.6))
              drop-shadow(0 0 8px rgba(51, 255, 51, 0.3));
    }
    50% { 
      filter: drop-shadow(0 0 6px rgba(51, 255, 51, 0.8))
              drop-shadow(0 0 12px rgba(51, 255, 51, 0.5));
    }
  }

  /* Genre Toggle Buttons */
  .genre-toggle {
    display: flex;
    background: var(--bg-deep, #0a0c0e);
    border: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .genre-btn {
    position: relative;
    background: transparent;
    border: none;
    color: var(--text-secondary, rgba(255, 255, 255, 0.5));
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 1;
  }

  .genre-btn:not(:last-child) {
    border-right: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
  }

  .genre-btn:hover:not(.active) {
    color: var(--text-primary, rgba(255, 255, 255, 0.85));
    background: rgba(255, 255, 255, 0.03);
  }

  /* Generic active state - green phosphor */
  .genre-btn.active {
    color: var(--phosphor-bright, #66ff66);
    background: rgba(51, 255, 51, 0.12);
    text-shadow: 0 0 8px rgba(51, 255, 51, 0.5);
    box-shadow: inset 0 0 12px rgba(51, 255, 51, 0.1);
  }

  .genre-btn-text {
    position: relative;
    z-index: 1;
  }

  /* Active indicator bar */
  .genre-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--phosphor-base, #33ff33), transparent);
    box-shadow: 0 0 8px rgba(51, 255, 51, 0.6);
  }

  .queue-count {
    font-size: 0.75rem;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .queue-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 400px;
    overflow-y: auto;
    transition: all 0.3s ease;
    padding: 0.5rem;
    border-radius: 8px;
    background: transparent;
  }


  .queue-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(51, 255, 51, 0.03);
    border: 1px solid rgba(51, 255, 51, 0.1);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .queue-item:hover {
    background: rgba(51, 255, 51, 0.08);
    border-color: rgba(51, 255, 51, 0.25);
  }

  .queue-item.active {
    background: rgba(51, 255, 51, 0.12);
    border-color: rgba(51, 255, 51, 0.3);
  }

  .queue-item-number {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(51, 255, 51, 0.5);
    min-width: 24px;
    text-align: center;
    transition: color 0.15s ease;
  }

  .queue-item.active .queue-item-number {
    color: var(--phosphor-bright, #66ff66);
  }

  .queue-item-title {
    flex: 1;
    font-size: 0.9rem;
    color: rgba(51, 255, 51, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease, text-shadow 0.15s ease;
    cursor: pointer;
  }

  .queue-item-title:hover {
    color: var(--phosphor-bright, #66ff66);
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.6);
  }

  .queue-item.active .queue-item-title {
    color: var(--phosphor-bright, #66ff66);
    font-weight: 600;
    text-shadow: 0 0 10px rgba(51, 255, 51, 0.5);
  }

  .queue-item-genre-badge {
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Scrollbar */
  .queue-list::-webkit-scrollbar {
    width: 6px;
  }

  .queue-list::-webkit-scrollbar-track {
    background: var(--bg-surface);
    border-radius: 3px;
  }

  .queue-list::-webkit-scrollbar-thumb {
    background: var(--border-base);
    border-radius: 3px;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .queue-section {
      padding: 1rem;
    }

    .queue-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .queue-header-right {
      width: 100%;
      justify-content: space-between;
    }

    .queue-list {
      max-height: 300px;
    }
  }
</style>
