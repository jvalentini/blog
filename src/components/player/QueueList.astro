---
interface Props {
  tracks: Array<{
    id: number;
    songId: string;
    title: string;
    versions: Record<string, string>;
  }>;
  genres: string[];
  defaultGenre: string;
}

const { tracks, genres, defaultGenre } = Astro.props;
---

<div class="queue-section">
  <div class="queue-header">
    <h3 class="queue-title" id="queue-title">Queue</h3>
    <div class="queue-header-right">
      <div class="genre-selector">
        <!-- Genre Icon - changes based on genre -->
        <div class="genre-icon" id="genre-icon" data-icon="generic">
          <!-- Hip-hop: Turntable -->
          <svg class="genre-icon-svg" data-icon-type="turntable" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <!-- Outer disc -->
            <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
            <!-- Inner circle (label) -->
            <circle cx="16" cy="16" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <!-- Center dot -->
            <circle cx="16" cy="16" r="1" fill="currentColor"/>
          </svg>
          <!-- Country: Cowboy Hat -->
          <svg class="genre-icon-svg" data-icon-type="cowboy-hat" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <polygon points="16,2 18.5,10 27,10 20,15 23,24 16,19 9,24 12,15 5,10 13.5,10" fill="currentColor"/>
            <circle cx="16" cy="14" r="4" fill="currentColor" opacity="0.3"/>
            <circle cx="16" cy="14" r="1.5" fill="currentColor" opacity="0.5"/>
          </svg>
          <!-- Rock: Electric Guitar -->
          <svg class="genre-icon-svg" data-icon-type="guitar" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <path d="M8 8 L12 24 L20 24 L24 8" stroke="currentColor" stroke-width="2" fill="none"/>
            <rect x="14" y="12" width="4" height="8" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <line x1="10" y1="20" x2="22" y2="20" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="16" r="1.5" fill="currentColor"/>
            <circle cx="20" cy="16" r="1.5" fill="currentColor"/>
            <line x1="8" y1="8" x2="6" y2="6" stroke="currentColor" stroke-width="2"/>
            <line x1="24" y1="8" x2="26" y2="6" stroke="currentColor" stroke-width="2"/>
          </svg>
          <!-- Weird: Accordion -->
          <svg class="genre-icon-svg" data-icon-type="spiral" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <!-- Left keyboard section -->
            <rect x="2" y="10" width="6" height="12" stroke="currentColor" stroke-width="2" fill="none"/>
            <!-- Bellows section with folds -->
            <path d="M 8 10 L 10 12 L 12 10 L 14 12 L 16 10 L 18 12 L 20 10 L 22 12 L 24 10" 
                  stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M 8 22 L 10 20 L 12 22 L 14 20 L 16 22 L 18 20 L 20 22 L 22 20 L 24 22" 
                  stroke="currentColor" stroke-width="2" fill="none"/>
            <!-- Right keyboard section -->
            <rect x="24" y="10" width="6" height="12" stroke="currentColor" stroke-width="2" fill="none"/>
            <!-- Button/key details -->
            <circle cx="5" cy="14" r="1" fill="currentColor" opacity="0.6"/>
            <circle cx="5" cy="18" r="1" fill="currentColor" opacity="0.6"/>
            <circle cx="27" cy="14" r="1" fill="currentColor" opacity="0.6"/>
            <circle cx="27" cy="18" r="1" fill="currentColor" opacity="0.6"/>
          </svg>
          <!-- Pop: Microphone -->
          <svg class="genre-icon-svg" data-icon-type="microphone" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <rect x="10" y="4" width="12" height="16" rx="6" stroke="currentColor" stroke-width="2" fill="none"/>
            <line x1="12" y1="8" x2="20" y2="8" stroke="currentColor" stroke-width="1" opacity="0.6"/>
            <line x1="12" y1="11" x2="20" y2="11" stroke="currentColor" stroke-width="1" opacity="0.8"/>
            <line x1="12" y1="14" x2="20" y2="14" stroke="currentColor" stroke-width="1" opacity="0.6"/>
            <line x1="12" y1="17" x2="20" y2="17" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            <line x1="16" y1="20" x2="16" y2="26" stroke="currentColor" stroke-width="2"/>
            <line x1="10" y1="26" x2="22" y2="26" stroke="currentColor" stroke-width="2"/>
            <path d="M6 10 Q4 12 6 14" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.5"/>
            <path d="M26 10 Q28 12 26 14" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.5"/>
          </svg>
          <!-- Bluegrass: Banjo -->
          <svg class="genre-icon-svg" data-icon-type="banjo" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <!-- Large circular body (drum head) on the right -->
            <circle cx="24" cy="16" r="7" stroke="currentColor" stroke-width="2" fill="none"/>
            <!-- Inner circle for resonator -->
            <circle cx="24" cy="16" r="4.5" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.6"/>
            <!-- Long neck extending left horizontally -->
            <rect x="4" y="15" width="18" height="2" fill="currentColor"/>
            <!-- Tuning pegs at left end (simple rectangles) -->
            <rect x="2" y="12" width="3" height="2" fill="currentColor"/>
            <rect x="2" y="14" width="3" height="2" fill="currentColor"/>
            <rect x="2" y="16" width="3" height="2" fill="currentColor"/>
            <rect x="2" y="18" width="3" height="2" fill="currentColor"/>
            <!-- Strings running horizontally along the neck to body -->
            <line x1="3.5" y1="12.5" x2="24" y2="12" stroke="currentColor" stroke-width="1" opacity="0.7"/>
            <line x1="3.5" y1="14.5" x2="24" y2="14" stroke="currentColor" stroke-width="1" opacity="0.7"/>
            <line x1="3.5" y1="16.5" x2="24" y2="18" stroke="currentColor" stroke-width="1" opacity="0.7"/>
            <line x1="3.5" y1="18.5" x2="24" y2="20" stroke="currentColor" stroke-width="1" opacity="0.7"/>
            <!-- Bridge on body (vertical line) -->
            <line x1="24" y1="9" x2="24" y2="23" stroke="currentColor" stroke-width="1.5" opacity="0.8"/>
          </svg>
          <!-- Generic fallback -->
          <svg class="genre-icon-svg" data-icon-type="generic" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 4 L12 20 C12 22.5 10 24.5 7.5 24.5 C5 24.5 3 22.5 3 20 C3 17.5 5 15.5 7.5 15.5 C8.5 15.5 9.5 15.8 10 16.2 L10 4 L12 4 Z" stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M20 4 L20 20 C20 22.5 22 24.5 24.5 24.5 C27 24.5 29 22.5 29 20 C29 17.5 27 15.5 24.5 15.5 C23.5 15.5 22.5 15.8 22 16.2 L22 4 L20 4 Z" stroke="currentColor" stroke-width="2" fill="none"/>
            <line x1="12" y1="4" x2="20" y2="4" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <!-- Genre Toggle Buttons -->
        <div class="genre-toggle" id="genre-toggle">
          {genres.map((genre) => {
            const genreDisplay = genre.split('-').map(word => 
              word.charAt(0).toUpperCase() + word.slice(1)
            ).join('-');
            return (
              <button 
                class={`genre-btn ${defaultGenre === genre ? 'active' : ''}`} 
                id={`genre-btn-${genre}`} 
                data-genre={genre}
              >
                <span class="genre-btn-text">{genreDisplay}</span>
              </button>
            );
          })}
        </div>
      </div>
      <span class="queue-count">{tracks.length} track{tracks.length !== 1 ? 's' : ''}</span>
    </div>
  </div>
  <div class="queue-list" id="queue-list">
    {tracks.map((track, idx) => (
      <div 
        class="queue-item" 
        data-index={idx}
        data-versions={JSON.stringify(track.versions)}
        data-title={track.title}
        data-song-id={track.songId}
      >
        <span class="queue-item-number">{idx + 1}</span>
        <span class="queue-item-title">{track.title}</span>
        <span class="queue-item-genre-badge" id={`genre-badge-${idx}`}></span>
      </div>
    ))}
  </div>
</div>

<style>
  /* Queue Section */
  .queue-section {
    background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(20, 25, 30, 0.7) 100%);
    border: 1px solid var(--genre-base, rgba(51, 255, 51, 0.2));
    border-radius: 12px;
    padding: 1.5rem;
    transition: border-color 0.3s ease;
  }

  .queue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--genre-dim, var(--phosphor-dim));
    flex-wrap: wrap;
    gap: 0.75rem;
    transition: border-color 0.3s ease;
  }

  .queue-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--genre-base, var(--phosphor-base));
    margin: 0;
    transition: color 0.3s ease, text-shadow 0.3s ease;
    text-shadow: 0 0 8px currentColor;
  }


  .queue-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .genre-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 30%, transparent);
    border-radius: 8px;
    padding: 0.5rem;
    background: rgba(0, 0, 0, 0.2);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 0 8px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 10%, transparent);
  }

  .genre-selector:hover {
    border-color: color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 50%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--genre-base, var(--phosphor-base)) 20%, transparent);
  }

  /* Genre Icon Container */
  .genre-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .genre-icon svg {
    width: 28px;
    height: 28px;
    transition: all 0.3s ease;
  }

  /* Genre icons - use genre colors */
  .genre-icon-svg {
    color: var(--genre-base, var(--phosphor-base, #33ff33));
    filter: drop-shadow(0 0 4px currentColor)
            drop-shadow(0 0 8px currentColor);
    animation: icon-pulse 2s ease-in-out infinite;
    transition: all 0.3s ease;
  }
  
  .genre-icon-svg[style*="display: none"] {
    display: none !important;
  }
  
  .genre-icon-svg:not([style*="display: none"]) {
    display: block !important;
  }

  @keyframes icon-pulse {
    0%, 100% { 
      filter: drop-shadow(0 0 4px currentColor)
              drop-shadow(0 0 8px currentColor);
    }
    50% { 
      filter: drop-shadow(0 0 6px currentColor)
              drop-shadow(0 0 12px currentColor);
    }
  }

  /* Genre Toggle Buttons */
  .genre-toggle {
    display: flex;
    background: var(--bg-deep, #0a0c0e);
    border: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .genre-btn {
    position: relative;
    background: transparent;
    border: none;
    color: var(--text-secondary, rgba(255, 255, 255, 0.5));
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 1;
  }

  .genre-btn:not(:last-child) {
    border-right: 1px solid var(--border-dim, rgba(51, 255, 51, 0.15));
  }

  .genre-btn:hover:not(.active) {
    color: var(--text-primary, rgba(255, 255, 255, 0.85));
    background: rgba(255, 255, 255, 0.03);
  }

  /* Active state - uses genre colors */
  .genre-btn.active {
    color: var(--genre-bright, var(--phosphor-bright, #66ff66));
    background: var(--genre-dim, rgba(51, 255, 51, 0.12));
    text-shadow: 0 0 8px currentColor;
    box-shadow: inset 0 0 12px var(--genre-dim, rgba(51, 255, 51, 0.1));
  }

  .genre-btn-text {
    position: relative;
    z-index: 1;
  }

  /* Active indicator bar */
  .genre-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--genre-base, var(--phosphor-base, #33ff33)), transparent);
    box-shadow: 0 0 8px currentColor;
  }

  .queue-count {
    font-size: 0.75rem;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .queue-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 400px;
    overflow-y: auto;
    transition: all 0.3s ease;
    padding: 0.5rem;
    border-radius: 8px;
    background: var(--genre-dim, transparent);
  }


  .queue-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--genre-dim, rgba(51, 255, 51, 0.03));
    border: 1px solid var(--genre-base, rgba(51, 255, 51, 0.1));
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .queue-item:hover {
    background: var(--genre-dim, rgba(51, 255, 51, 0.08));
    border-color: var(--genre-base, rgba(51, 255, 51, 0.25));
    filter: brightness(1.2);
  }

  .queue-item.active {
    background: var(--genre-dim, rgba(51, 255, 51, 0.12));
    border-color: var(--genre-base, rgba(51, 255, 51, 0.3));
    filter: brightness(1.3);
  }

  .queue-item-number {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--genre-base, rgba(51, 255, 51, 0.5));
    opacity: 0.5;
    min-width: 24px;
    text-align: center;
    transition: color 0.15s ease;
  }

  .queue-item.active .queue-item-number {
    color: var(--genre-bright, var(--phosphor-bright, #66ff66));
    opacity: 1;
  }

  .queue-item-title {
    flex: 1;
    font-size: 0.9rem;
    color: var(--genre-base, rgba(51, 255, 51, 0.7));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease, text-shadow 0.15s ease;
    cursor: pointer;
  }

  .queue-item-title:hover {
    color: var(--genre-bright, var(--phosphor-bright, #66ff66));
    text-shadow: 0 0 10px currentColor;
  }

  .queue-item.active .queue-item-title {
    color: var(--genre-bright, var(--phosphor-bright, #66ff66));
    font-weight: 600;
    text-shadow: 0 0 10px currentColor;
  }

  .queue-item-genre-badge {
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Scrollbar */
  .queue-list::-webkit-scrollbar {
    width: 6px;
  }

  .queue-list::-webkit-scrollbar-track {
    background: var(--bg-surface);
    border-radius: 3px;
  }

  .queue-list::-webkit-scrollbar-thumb {
    background: var(--border-base);
    border-radius: 3px;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .queue-section {
      padding: 1rem;
    }

    .queue-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .queue-header-right {
      width: 100%;
      justify-content: space-between;
    }

    .queue-list {
      max-height: 300px;
    }
  }
</style>
