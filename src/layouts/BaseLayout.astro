---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Terminal from '../components/Terminal.astro';
import { SITE_TITLE } from '../consts';

interface PlayerCardProps {
	embedUrl: string;
	streamUrl: string;
	slug: string;
	width?: number;
	height?: number;
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** Use wider content area (900px vs 720px) */
	wide?: boolean;
	/** Optional: enables Twitter Player Card for audio embeds */
	playerCard?: PlayerCardProps;
}

const { title, description, image, wide = false, playerCard } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} playerCard={playerCard} />
	</head>
	<body>
		<Header />
		<main class:list={[{ wide }]}>
			<slot />
		</main>
		<Footer />
		<Terminal />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
	}

	main.wide {
		max-width: var(--content-wide);
	}
</style>
