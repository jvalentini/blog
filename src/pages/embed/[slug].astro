---
import tracksData from '../../data/tracks.json';

interface Song {
	id: string;
	title: string;
	lyrics: Record<string, string>;
	versions: Record<string, string>;
}

interface TracksConfig {
	songs: Song[];
	genres: string[];
	defaultGenre: string;
}

export async function getStaticPaths() {
	const config = tracksData as TracksConfig;

	return config.songs.map((song) => ({
		params: { slug: song.id },
		props: {
			trackTitle: song.title,
			trackId: song.id,
			versions: song.versions,
			genres: config.genres,
			defaultGenre: config.defaultGenre,
		},
	}));
}

const { trackTitle, trackId, versions, genres, defaultGenre } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{trackTitle}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #1a1a1f;
      --bg-surface: #2a2a35;
      --phosphor: #33ff33;
      --phosphor-dim: rgba(51, 255, 51, 0.1);
      --text: #e0e0e0;
      --text-muted: #888;
      --border: #3a3a45;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .embed-player {
      width: 100%;
      max-width: 480px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .track-info {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .play-btn {
      width: 48px;
      height: 48px;
      border: 2px solid var(--phosphor);
      background: var(--phosphor-dim);
      color: var(--phosphor);
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .play-btn:hover {
      box-shadow: 0 0 20px rgba(51, 255, 51, 0.4);
    }

    .play-btn:active {
      transform: scale(0.95);
    }

    .track-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .track-artist {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .progress-container {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .time {
      font-size: 11px;
      color: var(--text-muted);
      min-width: 32px;
      font-variant-numeric: tabular-nums;
    }

    .time.current {
      text-align: right;
    }

    .progress-bar {
      flex: 1;
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--phosphor);
      width: 0%;
      transition: width 0.1s linear;
      box-shadow: 0 0 8px rgba(51, 255, 51, 0.5);
    }

    .genre-controls {
      margin-top: 12px;
      display: flex;
      gap: 8px;
      justify-content: center;
    }

    /* Use :global() for dynamically created buttons to bypass Astro's CSS scoping */
    .genre-controls :global(.genre-btn) {
      padding: 8px 16px;
      font-size: 12px;
      font-family: inherit;
      font-weight: 500;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s ease;
      text-transform: capitalize;
      outline: none;
    }

    .genre-controls :global(.genre-btn:hover) {
      border-color: var(--phosphor);
      color: var(--text);
    }

    .genre-controls :global(.genre-btn.active) {
      background: var(--phosphor-dim);
      border-color: var(--phosphor);
      color: var(--phosphor);
      box-shadow: 0 0 10px rgba(51, 255, 51, 0.2);
    }

    .genre-controls :global(.genre-btn:disabled) {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }

    .branding {
      margin-top: 12px;
      text-align: center;
      font-size: 10px;
      color: var(--text-muted);
    }

    .branding a {
      color: var(--phosphor);
      text-decoration: none;
    }

    .branding a:hover {
      text-decoration: underline;
    }

    /* Playing state */
    .embed-player.playing .play-btn {
      box-shadow: 0 0 20px rgba(51, 255, 51, 0.4);
    }
  </style>
</head>
<body>
  <div class="embed-player" id="player">
    <div class="track-info">
      <button class="play-btn" id="playBtn" aria-label="Play">
        <span id="playIcon">&#9654;</span>
      </button>
      <div>
        <div class="track-title">{trackTitle}</div>
        <div class="track-artist">jvalentini</div>
      </div>
    </div>
    
    <div class="progress-container">
      <span class="time current" id="currentTime">0:00</span>
      <div class="progress-bar" id="progressBar">
        <div class="progress-fill" id="progressFill"></div>
      </div>
      <span class="time" id="duration">0:00</span>
    </div>

    <div class="genre-controls" id="genreControls"></div>

    <div class="branding">
      <a href={`https://jvalentini.pages.dev/waves/${Astro.params.slug}`} target="_blank" rel="noopener">
        Listen on jvalentini.pages.dev
      </a>
    </div>
  </div>

  <audio id="audio" preload="metadata"></audio>

  <script is:inline define:vars={{ versions, defaultGenre, trackId }}>
    const audio = document.getElementById('audio');
    const playBtn = document.getElementById('playBtn');
    const playIcon = document.getElementById('playIcon');
    const player = document.getElementById('player');
    const progressBar = document.getElementById('progressBar');
    const progressFill = document.getElementById('progressFill');
    const currentTimeEl = document.getElementById('currentTime');
    const durationEl = document.getElementById('duration');
    const genreControls = document.getElementById('genreControls');

    let currentGenre = defaultGenre;
    let wasPlaying = false;
    let currentTime = 0;

    function formatTime(sec) {
      if (!isFinite(sec)) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ':' + s.toString().padStart(2, '0');
    }

    function loadGenre(genre) {
      wasPlaying = !audio.paused;
      currentTime = audio.currentTime || 0;
      currentGenre = genre;
      
      audio.src = `/assets/music/${versions[genre]}`;
      audio.load();
      
      document.querySelectorAll('.genre-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.genre === genre);
      });
    }

    audio.addEventListener('loadedmetadata', () => {
      durationEl.textContent = formatTime(audio.duration);
      if (currentTime > 0 && currentTime < audio.duration) {
        audio.currentTime = currentTime;
      }
      if (wasPlaying) {
        audio.play();
        playIcon.innerHTML = '&#10074;&#10074;';
        player.classList.add('playing');
      }
    });

    // Initialize genre buttons
    const availableGenres = Object.keys(versions);
    availableGenres.forEach(genre => {
      const btn = document.createElement('button');
      btn.className = 'genre-btn' + (genre === currentGenre ? ' active' : '');
      btn.textContent = genre;
      btn.dataset.genre = genre;
      btn.addEventListener('click', () => loadGenre(genre));
      
      // Add tooltip if only one genre available
      if (availableGenres.length === 1) {
        btn.setAttribute('title', 'This song only has 1 version available');
      }
      
      genreControls.appendChild(btn);
    });
    
    // Disable genre switching hotkey if only one genre
    const genreHotkeyEnabled = availableGenres.length > 1;

    // Load initial audio
    loadGenre(currentGenre);

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        playIcon.innerHTML = '&#10074;&#10074;';
        player.classList.add('playing');
      } else {
        audio.pause();
        playIcon.innerHTML = '&#9654;';
        player.classList.remove('playing');
      }
    });

    audio.addEventListener('timeupdate', () => {
      const pct = (audio.currentTime / audio.duration) * 100;
      progressFill.style.width = pct + '%';
      currentTimeEl.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener('ended', () => {
      playIcon.innerHTML = '&#9654;';
      player.classList.remove('playing');
      progressFill.style.width = '0%';
    });

    progressBar.addEventListener('click', (e) => {
      const rect = progressBar.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      audio.currentTime = pct * audio.duration;
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // Spacebar for play/pause
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        playBtn.click();
      }
      // G for genre switching (only if multiple genres available)
      else if ((e.key === 'g' || e.key === 'G') && genreHotkeyEnabled) {
        const genres = Object.keys(versions);
        const currentIndex = genres.indexOf(currentGenre);
        const nextIndex = (currentIndex + 1) % genres.length;
        loadGenre(genres[nextIndex]);
      }
    });
  </script>
</body>
</html>
