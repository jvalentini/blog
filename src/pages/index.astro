---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm {AUTHOR_NAME}</h1>
				<p>
					Software engineer with a passion for building tools and exploring AI-assisted development.
					I write about modern web technologies, development workflows, and lessons learned from
					building software.
				</p>
			</section>

			<section class="recent-posts">
				<h2>Recent Posts</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`}>
									<h3>{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
				<a href="/blog" class="view-all">View all posts →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	
	.intro {
		margin-bottom: 4em;
	}
	
	.intro h1 {
		font-size: 2.5em;
		font-weight: 700;
		line-height: 1.2;
		margin-bottom: 0.5em;
	}
	
	.intro p {
		font-size: 1.2em;
		line-height: 1.6;
		color: rgb(var(--gray));
	}

	.recent-posts h2 {
		font-size: 2em;
		font-weight: 700;
		margin-bottom: 1em;
	}

	.recent-posts ul {
		display: flex;
		flex-direction: column;
		gap: 2em;
		list-style-type: none;
		padding: 0;
	}

	.recent-posts li {
		transition: transform 0.2s;
	}

	.recent-posts li:hover {
		transform: translateX(4px);
	}

	.recent-posts a {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.recent-posts h3 {
		font-size: 1.5em;
		font-weight: 700;
		margin-bottom: 0.25em;
		color: rgb(var(--black));
	}

	.recent-posts .date {
		font-size: 0.9em;
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}

	.recent-posts .description {
		color: rgb(var(--gray-dark));
		line-height: 1.6;
	}

	.view-all {
		display: inline-block;
		margin-top: 2em;
		font-weight: 500;
		color: rgb(var(--accent));
		text-decoration: none;
	}

	.view-all:hover {
		text-decoration: underline;
	}
</style>
