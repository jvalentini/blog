---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="terminal-window">
					<div class="terminal-header">
						<span class="terminal-badge">tmux</span>
						<span class="terminal-title">0:zsh*</span>
						<span class="terminal-session">justin@blog</span>
					</div>
					<div class="terminal-body">
						<div class="line">
							<span class="prompt">$</span>
							<span class="command">whoami</span>
						</div>
						<div class="output name">{AUTHOR_NAME}</div>
						
						<div class="line">
							<span class="prompt">$</span>
							<span class="command">cat /etc/motd</span>
						</div>
						<pre class="output motd">Software engineer exploring AI-assisted development.
Building tools that make developers' lives easier.
Writing about modern web tech, workflows, and lessons learned.</pre>
						
						<div class="line">
							<span class="prompt">$</span>
							<span class="command">ls -la ~/skills</span>
						</div>
						<div class="output skills">
							<span class="skill">TypeScript</span>
							<span class="skill">Bun</span>
							<span class="skill">OpenCode</span>
							<span class="skill">Opus</span>
							<span class="skill">Codex</span>
							<span class="skill">Droid</span>
						</div>
						
						<div class="line cursor-line">
							<span class="prompt">$</span>
							<span class="cursor">_</span>
						</div>
					</div>
				</div>
			</section>

			<section class="posts">
				<h2>
					<span class="section-prefix">~/posts $</span> ls -lt | head -5
				</h2>
				
				<div class="post-list">
					{posts.map((post, index) => (
						<article class="post-item">
							<a href={`/blog/${post.id}/`}>
								<div class="post-meta">
									<span class="post-index">[{index}]</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-description">{post.data.description}</p>
							</a>
						</article>
					))}
				</div>
				
				<a href="/blog" class="view-all">
					<span class="prompt">$</span> cd ~/posts && ls -la
					<span class="arrow">-></span>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-wide);
	}

	.hero {
		margin-bottom: var(--space-3xl);
	}

	.terminal-window {
		background-color: var(--bg-deep);
		border: 1px solid var(--border-base);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 
			0 0 0 1px var(--border-dim),
			0 8px 32px rgba(0, 0, 0, 0.5),
			0 0 80px var(--phosphor-glow);
	}

	.terminal-header {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		padding: var(--space-xs) var(--space-md);
		background-color: var(--phosphor-dim);
		border-bottom: 1px solid var(--border-dim);
		font-size: var(--font-size-xs);
	}

	.terminal-badge {
		color: var(--bg-deep);
		background-color: var(--phosphor-base);
		padding: 1px var(--space-sm);
		font-weight: 600;
	}

	.terminal-title {
		color: var(--text-primary);
	}

	.terminal-session {
		margin-left: auto;
		color: var(--text-muted);
	}

	.terminal-body {
		padding: var(--space-lg);
		font-size: var(--font-size-sm);
		line-height: 1.8;
	}

	.line {
		display: flex;
		gap: var(--space-sm);
		margin-bottom: var(--space-xs);
	}

	.prompt {
		color: var(--phosphor-base);
		user-select: none;
	}

	.command {
		color: var(--text-primary);
	}

	.output {
		color: var(--text-secondary);
		padding-left: var(--space-lg);
		margin-bottom: var(--space-md);
	}

	.output.name {
		color: var(--phosphor-bright);
		font-size: var(--font-size-lg);
		font-weight: 600;
		text-shadow: var(--glow-sm);
	}

	.output.motd {
		font-family: var(--font-mono);
		margin: 0 0 var(--space-md) 0;
		padding: var(--space-sm) var(--space-lg);
		background: none;
		border: none;
		border-left: 2px solid var(--phosphor-dim);
		white-space: pre-wrap;
	}

	.output.skills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.skill {
		display: inline-block;
		padding: var(--space-xs) var(--space-sm);
		background-color: var(--bg-elevated);
		border: 1px solid var(--border-dim);
		border-radius: 4px;
		color: var(--amber-base);
		font-size: var(--font-size-xs);
	}

	.cursor-line {
		margin-top: var(--space-md);
	}

	.cursor {
		color: var(--phosphor-base);
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	.posts h2 {
		font-size: var(--font-size-lg);
		color: var(--text-secondary);
		margin-bottom: var(--space-xl);
		font-weight: 400;
	}

	.posts h2::before {
		display: none;
	}

	.section-prefix {
		color: var(--phosphor-base);
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.post-item {
		position: relative;
	}

	.post-item a {
		display: block;
		padding: var(--space-md) var(--space-lg);
		background-color: var(--bg-surface);
		border: 1px solid var(--border-dim);
		border-radius: 8px;
		text-decoration: none;
		transition: all var(--transition-base);
	}

	.post-item a:hover {
		border-color: var(--phosphor-dim);
		background-color: var(--bg-elevated);
		transform: translateX(4px);
		box-shadow: 
			-4px 0 0 var(--phosphor-base),
			0 0 20px var(--phosphor-glow);
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		font-size: var(--font-size-xs);
		color: var(--text-muted);
		margin-bottom: var(--space-xs);
	}

	.post-index {
		color: var(--phosphor-dim);
	}

	.post-title {
		font-size: var(--font-size-lg);
		font-weight: 500;
		color: var(--text-primary);
		margin: 0 0 var(--space-xs) 0;
		transition: color var(--transition-fast);
	}

	.post-item a:hover .post-title {
		color: var(--phosphor-base);
	}

	.post-description {
		font-size: var(--font-size-sm);
		color: var(--text-secondary);
		margin: 0;
		line-height: 1.5;
	}

	.view-all {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
		padding: var(--space-sm) var(--space-md);
		color: var(--text-secondary);
		font-size: var(--font-size-sm);
		text-decoration: none;
		border: 1px solid var(--border-dim);
		border-radius: 4px;
		transition: all var(--transition-fast);
	}

	.view-all:hover {
		color: var(--phosphor-base);
		border-color: var(--phosphor-dim);
		background-color: var(--bg-surface);
	}

	.view-all .prompt {
		color: var(--phosphor-base);
	}

	.view-all .arrow {
		color: var(--amber-base);
	}

	@media (max-width: 720px) {
		.terminal-body {
			padding: var(--space-md);
			font-size: var(--font-size-xs);
		}

		.output.name {
			font-size: var(--font-size-base);
		}

		.output.motd {
			font-size: var(--font-size-xs);
		}

		.post-item a {
			padding: var(--space-md);
		}

		.post-item a:hover {
			transform: none;
		}
	}
</style>
