---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Thanks! - ${SITE_TITLE}`} description="You're subscribed to the newsletter" />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="thanks-container">
					<span class="thanks-icon">&#10003;</span>
					<h1>You're subscribed!</h1>
					<p>Thanks for subscribing to my newsletter. You'll receive updates when I publish new posts.</p>
					<a href="/" class="back-link">&larr; Back to home</a>
				</div>
			</article>
		</main>
		<Footer />
		<style>
			.thanks-container {
				text-align: center;
				padding: var(--space-2xl) var(--space-lg);
				max-width: 500px;
				margin: 0 auto;
			}

			.thanks-icon {
				display: inline-block;
				width: 64px;
				height: 64px;
				line-height: 64px;
				font-size: 32px;
				border-radius: 50%;
				background-color: var(--phosphor-base);
				color: var(--bg-base);
				margin-bottom: var(--space-lg);
			}

			h1 {
				margin-bottom: var(--space-md);
			}

			p {
				color: var(--text-secondary);
				margin-bottom: var(--space-xl);
			}

			.back-link {
				color: var(--phosphor-base);
				text-decoration: none;
			}

			.back-link:hover {
				text-decoration: underline;
			}
		</style>
	</body>
</html>
