---
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title={`Thanks! - ${SITE_TITLE}`}
	description="Confirmation page for the jval.dev newsletter, with a quick link back to the homepage after subscribing to new software engineering posts."
>
	<article>
		<div class="thanks-container">
			<span class="thanks-icon">&#10003;</span>
			<h1>You're subscribed!</h1>
			<p>Thanks for subscribing to my newsletter. You'll receive updates when I publish new posts.</p>
			<a href="/" class="back-link">&larr; Back to home</a>
		</div>
	</article>
</BaseLayout>

<style>
	.thanks-container {
		text-align: center;
		padding: var(--space-2xl) var(--space-lg);
		max-width: 500px;
		margin: 0 auto;
	}

	.thanks-icon {
		display: inline-block;
		width: 64px;
		height: 64px;
		line-height: 64px;
		font-size: 32px;
		border-radius: 50%;
		background-color: var(--phosphor-base);
		color: var(--bg-base);
		margin-bottom: var(--space-lg);
	}

	h1 {
		margin-bottom: var(--space-md);
	}

	p {
		color: var(--text-secondary);
		margin-bottom: var(--space-xl);
	}

	.back-link {
		color: var(--phosphor-base);
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}
</style>
