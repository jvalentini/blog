---
import MusicPlayer from '../components/MusicPlayer.astro';
import WavesLayout from '../layouts/WavesLayout.astro';
import wavesHeroImage from '../assets/waves-hero.png';

const pageTitle = 'waves';
const pageDescription = 'A collection of original tracks and creative experiments.';
---

<WavesLayout title={pageTitle} description={pageDescription} image={wavesHeroImage}>
	<section class="player-section">
		<MusicPlayer />
	</section>
</WavesLayout>

<style is:global>
	/* Hide scrollbar on waves page */
	html:has(.player-section) {
		overflow-y: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	
	html:has(.player-section)::-webkit-scrollbar {
		display: none;
		width: 0;
	}
</style>

<style>
	.player-section {
		margin-bottom: var(--space-3xl);
		animation: fadeInUp 0.8s ease-out both;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
