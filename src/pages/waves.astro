---
import MusicPlayer from '../components/MusicPlayer.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'waves';
const pageDescription = 'A collection of original tracks and creative experiments.';
---

<BaseLayout title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} image="/waves-hero.png" wide>
	<section class="player-section">
		<MusicPlayer />
	</section>
</BaseLayout>

<style is:global>
	/* Hide scrollbar on waves page */
	html:has(.player-section) {
		overflow-y: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	
	html:has(.player-section)::-webkit-scrollbar {
		display: none;
		width: 0;
	}
</style>

<style>
	.player-section {
		margin-bottom: var(--space-3xl);
		animation: fadeInUp 0.8s ease-out both;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
