---
import wavesHeroImage from '../../assets/waves-hero.png';
import MusicPlayer from '../../components/MusicPlayer.astro';
import { SITE_TITLE } from '../../consts';
import tracksData from '../../data/tracks.json';
import WavesLayout from '../../layouts/WavesLayout.astro';
import { type AudioVersionMap, getAbsoluteAudioAssetUrl, getAudioVersionEntries } from '../../utils/audio-assets';

interface Song {
	id: string;
	title: string;
	lyrics: Record<string, string | undefined>;
	versions: AudioVersionMap;
}

interface TracksConfig {
	songs: Song[];
	genres: string[];
	defaultGenre: string;
}

export async function getStaticPaths() {
	const config = tracksData as TracksConfig;

	return config.songs.map((song) => ({
		params: { slug: song.id },
		props: {
			trackTitle: song.title,
			trackSlug: song.id,
			// Use the default genre's filename for the embed
			filename: song.versions[config.defaultGenre] ?? getAudioVersionEntries(song.versions)[0]?.[1] ?? '',
		},
	}));
}

const { trackTitle, trackSlug, filename } = Astro.props;
const pageTitle = 'waves';
const metaTrackTitle = trackTitle.length > 38 ? `${trackTitle.slice(0, 35)}...` : trackTitle;
const pageDescription = `Listen to ${metaTrackTitle} in the Waves audio player, with controls, playlists, lyrics where available, and shareable embeds.`;

const siteUrl = Astro.site?.origin ?? 'https://jvalentini.pages.dev';
const playerCard = {
	embedUrl: `${siteUrl}/embed/${trackSlug}`,
	streamUrl: getAbsoluteAudioAssetUrl(filename, siteUrl),
	slug: trackSlug,
	width: 480,
	height: 200,
};
---

<WavesLayout title={`${metaTrackTitle} | ${pageTitle} | ${SITE_TITLE}`} description={pageDescription} image={wavesHeroImage} playerCard={playerCard}>
	<section class="player-section">
		<MusicPlayer />
	</section>
</WavesLayout>

<style>
	.player-section {
		margin-bottom: var(--space-3xl);
		animation: fadeInUp 0.8s ease-out 0.2s both;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
