---
import MusicPlayer from '../../components/MusicPlayer.astro';
import { SITE_TITLE } from '../../consts';
import tracksData from '../../data/tracks.json';
import WavesLayout from '../../layouts/WavesLayout.astro';

interface Song {
	id: string;
	title: string;
	lyrics: string;
	versions: Record<string, string>;
}

interface TracksConfig {
	songs: Song[];
	genres: string[];
	defaultGenre: string;
}

export async function getStaticPaths() {
	const config = tracksData as TracksConfig;

	return config.songs.map((song) => ({
		params: { slug: song.id },
		props: {
			trackTitle: song.title,
			trackSlug: song.id,
			// Use the default genre's filename for the embed
			filename: song.versions[config.defaultGenre] || Object.values(song.versions)[0],
		},
	}));
}

const { trackTitle, trackSlug, filename } = Astro.props;
const pageTitle = 'waves';
const pageDescription = `Listen to ${trackTitle} - A collection of original tracks and creative experiments.`;

const siteUrl = Astro.site?.origin ?? 'https://jvalentini.pages.dev';
const playerCard = {
	embedUrl: `${siteUrl}/embed/${trackSlug}`,
	streamUrl: `${siteUrl}/assets/music/${filename}`,
	slug: trackSlug,
	width: 480,
	height: 200,
};
---

<WavesLayout title={`${trackTitle} | ${pageTitle} | ${SITE_TITLE}`} description={pageDescription} image="/waves-hero.png" playerCard={playerCard}>
	<section class="player-section">
		<MusicPlayer />
	</section>
</WavesLayout>

<style>
	.player-section {
		margin-bottom: var(--space-3xl);
		animation: fadeInUp 0.8s ease-out 0.2s both;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
