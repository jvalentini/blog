{
  "name": "suno-cli",
  "version": "1.0.0",
  "description": "CLI tool for Suno API integration with retry logic and Playwright token refresh",
  "type": "module",
  "bin": {
    "suno": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "exponential-backoff": "^3.1.3",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "typescript": "^5.9.3"
  }
}
